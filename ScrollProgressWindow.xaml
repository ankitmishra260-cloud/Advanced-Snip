<Window x:Class="AdvancedSnip.ScrollProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Advanced Snip – Scroll Capture"
        Width="470" SizeToContent="Height"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        FontFamily="Segoe UI">

    <Border CornerRadius="14"
            Background="#FA1D2027"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            Padding="22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="5" Opacity="0.55" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Top">
                <TextBlock Text="Scroll capture"
                           Foreground="#FF94A3B8" FontSize="11" FontWeight="SemiBold"/>

                <TextBlock x:Name="TitleText"
                           Text="Capturing…"
                           Foreground="White"
                           FontSize="15" FontWeight="SemiBold"
                           Margin="0,4,0,0"
                           TextTrimming="CharacterEllipsis"/>

                <ProgressBar x:Name="Bar"
                             Height="6"
                             Minimum="0" Maximum="100" Value="0"
                             Margin="0,16,0,0"
                             Background="#22FFFFFF"
                             Foreground="#FF3B82F6"
                             BorderThickness="0"/>

                <TextBlock x:Name="StatusText"
                           Text="Preparing…"
                           Foreground="#FFCBD5E1"
                           FontSize="12"
                           Margin="0,10,0,0"
                           TextWrapping="Wrap"/>

                <TextBlock x:Name="StatsText"
                           Text=""
                           Foreground="#FF64748B"
                           FontSize="11"
                           Margin="0,4,0,0"/>

                <TextBlock Text="Please don't touch the mouse or keyboard while this runs."
                           Foreground="#FF64748B"
                           FontSize="11"
                           Margin="0,10,0,0"
                           TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                    <Button x:Name="StopBtn"
                            Content="Stop &amp; keep"
                            Click="StopBtn_Click"
                            Padding="14,7" FontSize="12"
                            Background="#FF3B82F6" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            Margin="0,0,8,0"/>
                    <Button x:Name="CancelBtn"
                            Content="Cancel"
                            Click="CancelBtn_Click"
                            Padding="14,7" FontSize="12"
                            Background="#22FFFFFF" Foreground="White"
                            BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>

            <!-- Live stitched preview -->
            <Border Grid.Column="1"
                    Width="112" Height="210"
                    Margin="18,0,0,0"
                    CornerRadius="8"
                    Background="#14FFFFFF"
                    BorderBrush="#22FFFFFF"
                    BorderThickness="1"
                    ClipToBounds="True"
                    VerticalAlignment="Top">
                <Image x:Name="PreviewImage"
                       Stretch="Uniform"
                       VerticalAlignment="Top"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
        </Grid>
    </Border>
</Window>
