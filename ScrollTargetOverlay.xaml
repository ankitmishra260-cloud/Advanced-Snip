<Window x:Class="AdvancedSnip.ScrollTargetOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Advanced Snip – Pick what to scroll-capture"
        Background="Black"
        AllowsTransparency="False"
        Cursor="Cross">

    <Grid x:Name="RootGrid"
          MouseMove="Root_MouseMove"
          MouseLeftButtonDown="Root_Click"
          MouseRightButtonDown="Root_Cancel"
          MouseWheel="Root_MouseWheel">

        <!-- Frozen desktop snapshot so the scene can't shift while you aim -->
        <Image x:Name="ScreenImage" Stretch="Fill" />

        <Canvas x:Name="Layer">
            <!-- Dim everything except the region under the cursor -->
            <Path x:Name="DimPath" Fill="#88000000" />

            <Border x:Name="HoverBorder"
                    BorderBrush="#FF3B82F6"
                    BorderThickness="3"
                    Background="#183B82F6"
                    Visibility="Collapsed"
                    IsHitTestVisible="False" />

            <!-- Info card that follows the pointer -->
            <Border x:Name="TipBorder"
                    Background="#F21E293B"
                    CornerRadius="10"
                    Padding="16,12"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.55" Color="Black"/>
                </Border.Effect>
                <StackPanel MaxWidth="460">
                    <TextBlock x:Name="TipTitle"
                               Foreground="White"
                               FontFamily="Segoe UI"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Border x:Name="TipBadge"
                                Background="#FF2563EB"
                                CornerRadius="4"
                                Padding="7,2"
                                Margin="0,0,8,0">
                            <TextBlock x:Name="TipBadgeText"
                                       Foreground="White"
                                       FontFamily="Segoe UI"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock x:Name="TipDetail"
                                   Foreground="#FFCBD5E1"
                                   FontFamily="Segoe UI"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="TipHint"
                               Foreground="#FF94A3B8"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Text="Click to capture  ·  Scroll wheel to widen or narrow the target  ·  Esc to cancel"/>
                </StackPanel>
            </Border>
        </Canvas>

        <!-- Top hint bar, pinned to the monitor under the cursor -->
        <Border x:Name="HintBar"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="#E61E293B"
                CornerRadius="10"
                Padding="18,10">
            <TextBlock Foreground="White"
                       FontFamily="Segoe UI"
                       FontSize="14"
                       Text="Point at the area you want scroll-captured, then click."/>
        </Border>
    </Grid>
</Window>
