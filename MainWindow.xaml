                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="SCROLL CAPTURE" Style="{StaticResource CardHead}"/>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="Capture speed" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="ScrollSpeedCombo" Width="150" HorizontalAlignment="Left"
                                              Padding="8,4" FontSize="13">
                                        <ComboBoxItem Content="Fast"/>
                                        <ComboBoxItem Content="Balanced"/>
                                        <ComboBoxItem Content="Thorough"/>
                                    </ComboBox>
                                </DockPanel>
                                <TextBlock Text="How long to wait for each screenful to finish drawing. Use Thorough for pages that load images as you scroll."
                                           Foreground="{DynamicResource Brush.TextMuted}" FontSize="11" Margin="170,0,0,12" TextWrapping="Wrap"/>

                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="Maximum image height" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextBody}" FontSize="13"
                                               MinWidth="70" Margin="8,0,0,0"
                                               Text="{Binding ElementName=ScrollHeightSlider, Path=Value, StringFormat={}{0:0} px}"/>
