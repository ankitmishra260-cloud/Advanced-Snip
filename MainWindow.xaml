                                                   TextWrapping="Wrap" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.TextBody}"/>
                                    </DockPanel>
                                </Border>

                                <CheckBox x:Name="ShowOnStartChk" Foreground="{DynamicResource Brush.TextBody}"
                                          Margin="0,12,0,0" Content="Open this window when the app starts"/>
                                <TextBlock Text="A sign-in launch always goes straight to the tray, whatever this is set to."
                                           Foreground="{DynamicResource Brush.TextMuted}" FontSize="11"
                                           Margin="24,3,0,0"/>
                                <CheckBox x:Name="MinimiseChk" Foreground="{DynamicResource Brush.TextBody}"
                                          Margin="0,8,0,0" Content="Minimise to tray when this window is closed"/>
