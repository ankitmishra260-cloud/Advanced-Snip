                            <TextBlock Style="{StaticResource HelpP}" Text="Draw live on screen during recording by pressing Ctrl+Shift+A for the radial tool palette (1–9 to pick tools, pin to keep visible)."/>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource HelpKey}" Margin="12,0,0,0" Text="hold Shift"/>
                                <TextBlock Style="{StaticResource HelpP}" Margin="0" Text="Straight line"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,6">
