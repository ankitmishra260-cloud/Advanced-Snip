                            <TextBlock Style="{StaticResource HelpP}" Text="• Split across pages — scales the capture to standard paper with adjustable seam overlap and multi-column zoom tiling."/>
                            <TextBlock Style="{StaticResource HelpP}" Text="• One page as tall as the image — seamless custom-height single page without scaling or breaks."/>
                            <TextBlock Style="{StaticResource HelpP}" Text="• Fit whole image on one page — shrinks onto A4/Letter with alignment options (left, centered, right)."/>
                            <TextBlock Style="{StaticResource HelpP}" Text="Browse and view all exported documents directly inside the gallery's dedicated PDFs tab."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
