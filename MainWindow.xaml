<Window x:Class="AdvancedSnip.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:AdvancedSnip"
        xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
        Title="Advanced Snip"
        Icon="ASico.ico"
        Width="1280" Height="780"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        StateChanged="Window_StateChanged">

    <!-- The window draws its own title bar. WindowChrome rather than
         WindowStyle="None" so the real frame survives: Aero Snap, snap layouts on the
         maximize button, drag-to-tile, double-click-to-maximize and the resize grips all
         keep coming from Windows instead of being reimplemented. CaptionHeight makes the
         top strip draggable; anything clickable up there opts out with
         shell:WindowChrome.IsHitTestVisibleInChrome. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Sidebar nav button style -->
        <Style x:Key="NavBtn" TargetType="RadioButton">
            <Setter Property="Background"   Value="Transparent"/>
            <Setter Property="Foreground"   Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"      Value="18,12"/>
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="FontFamily"   Value="Segoe UI"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="GroupName"    Value="Nav"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Margin="6,2">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.NavActive}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title-bar buttons. Sized to Windows' own 46×32 so the row reads as a real
             caption rather than a toolbar that happens to be at the top. -->
        <!-- Minimise / maximise / close. These fill the caption strip rather than being
             inset in it: the close button has to reach the top-right corner, or throwing
             the pointer into the corner — which is how it is actually hit — lands on the
             window frame instead. Height tracks WindowChrome.CaptionHeight. -->
        <Style x:Key="CaptionBtn" TargetType="Button">
            <Setter Property="Width"           Value="46"/>
            <Setter Property="Height"          Value="42"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource Brush.TextBody}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily"      Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize"        Value="10"/>
            <Setter Property="Focusable"       Value="False"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource Brush.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close is the one destructive control up there, so it gets the standard red
             rather than the neutral hover. -->
        <Style x:Key="CaptionCloseBtn" TargetType="Button" BasedOn="{StaticResource CaptionBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter x:Name="Cp" HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFE81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The settings card. Recording already looked like this, inline; the other
             panes put their controls straight onto the page background, so on the light
             theme they floated on the creamy Brush.Subtle with nothing to sit on. One
             keyed style now, rather than five copies that drift. -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource Brush.Card}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="18,16"/>
            <Setter Property="Margin"          Value="0,0,0,14"/>
        </Style>

        <!-- The heading inside a card. Same metrics the Recording tab used inline. -->
        <Style x:Key="CardHead" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="Margin"     Value="0,0,0,12"/>
        </Style>

        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Foreground"   Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="Margin"       Value="0,18,0,8"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground"        Value="{DynamicResource Brush.TextBody}"/>
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="MinWidth"          Value="170"/>
        </Style>
        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Padding"      Value="12,6"/>
            <Setter Property="Background"   Value="{DynamicResource Brush.Card}"/>
            <Setter Property="Foreground"   Value="{DynamicResource Brush.TextBody}"/>
            <Setter Property="BorderBrush"  Value="{DynamicResource Brush.BorderInput}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="FontSize"     Value="13"/>
            <!-- An explicit template is needed, not just a Background setter: the stock
                 Button template overrides Background from system brushes on hover, so a
                 themed button would flash light blue on a dark card. -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{DynamicResource Brush.Accent}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource Brush.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Filled call-to-action button. Same reasoning as Ghost above: the stock
             Button template repaints Background from system brushes on hover, so the
             accent fill needs an explicit template to survive a theme swap. -->
        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Padding"      Value="18,7"/>
            <Setter Property="Background"   Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Foreground"   Value="{DynamicResource Brush.OnAccent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource Brush.AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HotkeyBox" TargetType="TextBox">
            <Setter Property="IsReadOnly"              Value="True"/>
            <Setter Property="IsReadOnlyCaretVisible"  Value="False"/>
            <Setter Property="Padding"                 Value="8,6"/>
            <Setter Property="FontSize"                Value="13"/>
            <Setter Property="Cursor"                  Value="Hand"/>
            <Setter Property="Background"              Value="{DynamicResource Brush.Input}"/>
            <Setter Property="Foreground"              Value="{DynamicResource Brush.Text}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Gallery thumb card -->
        <Style x:Key="GalleryItem" TargetType="ListBoxItem">
            <Setter Property="Padding"  Value="0"/>
            <Setter Property="Margin"   Value="6"/>
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="GalleryItem_PreviewMouseRightButtonDown"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" CornerRadius="10"
                                Background="{DynamicResource Brush.Card}"
                                BorderBrush="Transparent" BorderThickness="2">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2"
                                                  Opacity="0.10" Color="Black"
                                                  RenderingBias="Performance"/>
                            </Border.Effect>
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Accent}"/>
                                <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Quick actions in the title bar. IsHitTestVisibleInChrome is mandatory: without
             it WindowChrome treats the whole 34px strip as caption and the clicks become
             window drags. -->
        <Style x:Key="QuickBtn" TargetType="Button">
            <Setter Property="Height"          Value="28"/>
            <Setter Property="Padding"         Value="11,0"/>

            <!-- Top margin larger than the bottom on purpose. The buttons sit in a strip
                 whose top edge is the edge of the window, and optical centring there looks
                 crowded against it; a couple of pixels of extra clearance above reads as
                 deliberate spacing rather than a near miss. -->
            <Setter Property="Margin"          Value="3,3,0,1"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource Brush.TextBody}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize"        Value="11.5"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Focusable"       Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- The tint is the button's own colour at low opacity, rather
                                 than a fixed grey. Tag carries a palette brush, so each
                                 theme supplies its own version of "the snip colour" and
                                 none of this needs a hardcoded hex.

                                 Opacity on a solid brush rather than a second alpha brush
                                 per colour per theme: that would be twelve more keys to
                                 keep in sync across three palettes for a background nobody
                                 will name. -->
                            <Border x:Name="Tint" CornerRadius="5" Opacity="0.16"
                                    Background="{Binding Tag,
                                        RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Border x:Name="Bd" CornerRadius="5"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tint" Property="Opacity" Value="0.34"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Tint" Property="Opacity" Value="0.48"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Tint" Property="Opacity" Value="0"/>
                                <Setter Property="Opacity" Value="0.35"/>
                                <Setter Property="Cursor"  Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented sub-navigation, used by both the gallery (images / videos) and the
             settings page. A page with eight unrelated sections in one scroll is a page
             where nothing can be found; splitting it costs one click and saves the hunt. -->
        <Style x:Key="SubTab" TargetType="RadioButton">
            <Setter Property="Padding"    Value="14,6"/>
            <Setter Property="Margin"     Value="0,0,4,0"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="FontSize"   Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="6" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource Brush.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource Brush.AccentSoft}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource Brush.Accent}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Help page typography. Declared here rather than repeated on ~120 TextBlocks,
             which is how the old About page was written and why it was never updated. -->
        <Style x:Key="HelpH" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Margin"     Value="0,26,0,10"/>
        </Style>

        <Style x:Key="HelpP" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="LineHeight"   Value="21"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground"   Value="{DynamicResource Brush.Text}"/>
            <Setter Property="Margin"       Value="0,0,0,7"/>
        </Style>

        <Style x:Key="HelpKey" TargetType="TextBlock" BasedOn="{StaticResource HelpP}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="FontFamily" Value="Consolas, Segoe UI"/>
        </Style>
    </Window.Resources>

    <!-- The window's own outline. GlassFrameThickness is 0, so nothing else draws one,
         and a light window on a white desktop or a dark one on a black desktop simply
         bled into the background with no telling where the app stopped. Dropped when
         maximised, where the edge is the screen edge and a line would just eat a pixel. -->
    <Border x:Name="WindowEdge"
            BorderBrush="{DynamicResource Brush.WindowEdge}" BorderThickness="1">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <!-- Kept in step with WindowChrome.CaptionHeight above. If the row is taller
                 than the caption, the extra strip stops being draggable; if it is shorter,
                 the caption steals clicks from whatever is below it. -->
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ TITLE BAR ═══════════ -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Sidebar}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <!-- Segoe MDL2 glyphs: E7C4 tray, E921 minimise, E922/E923 maximise
                         and restore, E8BB close. -->
                    <Button x:Name="TrayBtn" Style="{StaticResource CaptionBtn}"
                            Content="&#xE7C4;" ToolTip="Minimise to tray"
                            Click="HideBtn_Click"/>
                    <Button x:Name="MinBtn" Style="{StaticResource CaptionBtn}"
                            Content="&#xE921;" ToolTip="Minimise"
                            Click="Minimise_Click"/>
                    <Button x:Name="MaxBtn" Style="{StaticResource CaptionBtn}"
                            Content="&#xE922;" ToolTip="Maximise"
                            Click="MaximiseRestore_Click"/>
                    <Button x:Name="CloseBtn" Style="{StaticResource CaptionCloseBtn}"
                            Content="&#xE8BB;" ToolTip="Close"
                            Click="CloseBtn_Click"/>
                </StackPanel>

                <!-- TextBody, not TextMuted. Muted grey on the light title bar measured
                     2.4:1 — below even the 3:1 floor for interface text, and the reason the
                     app's own name was the least legible thing on its window. TextBody puts
                     it at 7.1:1 without making it shout. -->
                <TextBlock x:Name="CaptionTitle" DockPanel.Dock="Left"
                           VerticalAlignment="Center" Margin="14,0,12,0"
                           FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.TextBody}"
                           Text="Advanced Snip"/>

                <!-- The two things this app exists to do, one click from anywhere in it.
                     They were previously reachable only by knowing the global hotkey or by
                     finding a button at the bottom of the sidebar, which is a long way to
                     travel for the primary action. -->
                <Rectangle DockPanel.Dock="Left" Width="1" Margin="0,8" VerticalAlignment="Stretch"
                           Fill="{DynamicResource Brush.Border}"/>

                <!-- Each action carries a colour from the palette's semantic brushes, not a
                     hex: accent for snip, success for scroll, danger for record, warning
                     for history. Every palette already defines all four and already
                     guarantees they read against its own background, so this stays visible
                     in Light, Dark and Cyberpunk without a per-theme special case.

                     The glyph takes the colour and the label stays neutral. Four
                     differently-coloured words in a row is a toybox; a coloured mark
                     beside a plain word is a signpost. -->
                <Button x:Name="QuickSnipBtn" DockPanel.Dock="Left" Style="{StaticResource QuickBtn}"
                        Margin="7,0,0,0" Click="QuickSnip_Click"
                        Tag="{DynamicResource Brush.Accent}"
                        ToolTip="Capture a region of the screen (Ctrl+Shift+S)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x2702;" FontSize="13" Margin="0,0,6,0"
                                   VerticalAlignment="Center" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Accent}"/>
                        <TextBlock Text="Snip" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="QuickSnipTimerBtn" DockPanel.Dock="Left" Style="{StaticResource QuickBtn}"
                        Margin="2,0,0,0" Click="QuickSnipTimer_Click"
                        Tag="{DynamicResource Brush.Accent}"
                        ToolTip="Screenshot timer delay (Click to choose preset: No delay, 3s, 10s, 20s)">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="SnipTimerContextMenu">
                            <MenuItem x:Name="SnipTimerNone" Header="No delay (Instant)" Click="SnipTimerPreset_Click" Tag="0"/>
                            <MenuItem x:Name="SnipTimer3s" Header="3 seconds" Click="SnipTimerPreset_Click" Tag="3"/>
                            <MenuItem x:Name="SnipTimer10s" Header="10 seconds" Click="SnipTimerPreset_Click" Tag="10"/>
                            <MenuItem x:Name="SnipTimer20s" Header="20 seconds" Click="SnipTimerPreset_Click" Tag="20"/>
                            <Separator/>
                            <MenuItem Header="Snip with timer now" Click="SnipTimerNow_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource Brush.Accent}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" FontSize="11.5" Margin="0,0,5,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Accent}"/>
                        <TextBlock x:Name="QuickSnipTimerText" Text="Off" VerticalAlignment="Center"/>
                        <TextBlock Text="&#xE96E;" FontFamily="Segoe MDL2 Assets" FontSize="8" Margin="4,2,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                    </StackPanel>
                </Button>

                <Button x:Name="QuickScrollBtn" DockPanel.Dock="Left" Style="{StaticResource QuickBtn}"
                        Click="QuickScroll_Click"
                        Tag="{DynamicResource Brush.Success}"
                        ToolTip="Capture a whole scrolling page (Ctrl+Shift+W)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x21F2;" FontSize="13" Margin="0,0,6,0"
                                   VerticalAlignment="Center" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Success}"/>
                        <TextBlock Text="Scroll" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="QuickRecordBtn" DockPanel.Dock="Left" Style="{StaticResource QuickBtn}"
                        Click="QuickRecord_Click"
                        Tag="{DynamicResource Brush.Danger}"
                        ToolTip="Start recording the screen (Ctrl+Shift+R)">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="QuickRecordDot" Width="10" Height="10" Margin="0,0,6,0"
                                 VerticalAlignment="Center" Fill="{DynamicResource Brush.Danger}"/>
                        <TextBlock x:Name="QuickRecordText" Text="Record" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="QuickOcrBtn" DockPanel.Dock="Left" Style="{StaticResource QuickBtn}"
                        Click="QuickOcr_Click"
                        Tag="{DynamicResource Brush.Accent}"
                        ToolTip="Extract text directly from screen (Ctrl+Shift+O)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C4;" FontFamily="Segoe MDL2 Assets" FontSize="12.5" Margin="0,0,6,0"
                                   VerticalAlignment="Center" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Accent}"/>
                        <TextBlock Text="OCR" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="QuickHistoryBtn" DockPanel.Dock="Left" Style="{StaticResource QuickBtn}"
                        Click="QuickHistory_Click"
                        IsEnabled="False"
                        Tag="{DynamicResource Brush.Warning}"
                        ToolTip="Show the clipboard history (Ctrl+Shift+V)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x2750;" FontSize="13" Margin="0,0,6,0"
                                   VerticalAlignment="Center" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}}" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="History" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextBody}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}}" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>

                <Button x:Name="QuickClearClipBtn" DockPanel.Dock="Left" Style="{StaticResource QuickBtn}"
                        Click="QuickClearClip_Click"
                        IsEnabled="False"
                        Tag="{DynamicResource Brush.Danger}"
                        ToolTip="Empty the clipboard history and the Windows clipboard">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x2717;" FontSize="13" Margin="0,0,6,0"
                                   VerticalAlignment="Center" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}}" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="Clear" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextBody}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}}" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>

                <!-- Fill. CaptionHeight makes this strip draggable and double-clicking it
                     maximises, both handled by Windows — which is why nothing that needs a
                     click may live here without IsHitTestVisibleInChrome. -->
                <Border/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════ SIDEBAR ═══════════ -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.Sidebar}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Logo area -->
                <StackPanel DockPanel.Dock="Top" Margin="18,22,18,16">
                    <TextBlock Text="✂ Advanced Snip"
                               FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Brush.Text}"/>
                    <TextBlock x:Name="VersionText" Text="v3.0.0 by Ankit Mishra"
                               FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Nav -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <RadioButton x:Name="NavGallery"
                                 Style="{StaticResource NavBtn}" IsChecked="True"
                                 Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🖼" Width="22" TextAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Gallery" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavRecord"
                                 Style="{StaticResource NavBtn}"
                                 Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⏺" Width="22" TextAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Record" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSettings"
                                 Style="{StaticResource NavBtn}"
                                 Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚙" Width="22" TextAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavHelp"
                                 Style="{StaticResource NavBtn}"
                                 Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="?" Width="22" TextAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                            <TextBlock Text="Help" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Bottom quick-actions -->
                <!-- "Snip now" used to live here. It has moved to the title bar, where it
                     sits beside the other three things this app does rather than alone at
                     the bottom of a navigation rail. -->
                <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,16">
                    <Button Content="Minimize to tray" Style="{StaticResource Ghost}"
                            Click="HideBtn_Click" HorizontalAlignment="Stretch"/>
                </StackPanel>

                <Border/><!-- spacer -->
            </DockPanel>
        </Border>

        <!-- ═══════════ CONTENT AREA ═══════════ -->
        <Grid Grid.Column="1">

            <!-- ─── GALLERY ─── -->
            <Grid x:Name="PageGallery">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Toolbar: search, sort, and the actions that act on a selection -->
                <Border Grid.Row="0" Background="{DynamicResource Brush.Card}"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                        Padding="16,10">
                    <StackPanel>
                        <DockPanel>
                            <!-- Recordings used to be invisible from here: the app wrote
                                 MP4s and then offered nowhere to find them again. Images and
                                 videos are separate lists rather than one mixed grid because
                                 the questions people ask of them differ — you search pictures
                                 for the words inside them, and videos by when and how long. -->
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="0,0,4,0">
                                <RadioButton x:Name="GalleryTabImages" Style="{StaticResource SubTab}"
                                             GroupName="GalleryMode" IsChecked="True"
                                             Content="&#x1F5BC; Images" Checked="GalleryMode_Checked"/>
                                <RadioButton x:Name="GalleryTabVideos" Style="{StaticResource SubTab}"
                                             GroupName="GalleryMode"
                                             Content="&#x1F3AC; Videos" Checked="GalleryMode_Checked"/>
                                <RadioButton x:Name="GalleryTabPdfs" Style="{StaticResource SubTab}"
                                             GroupName="GalleryMode"
                                             Content="&#x1F4C4; PDFs" Checked="GalleryMode_Checked"/>
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <TextBlock Text="Sort" VerticalAlignment="Center" FontSize="12"
                                           Margin="0,0,6,0"
                                           Foreground="{DynamicResource Brush.TextMuted}"/>
                                <ComboBox x:Name="GallerySortCombo" Width="150" FontSize="12"
                                          VerticalContentAlignment="Center"
                                          SelectionChanged="GallerySort_Changed">
                                    <ComboBoxItem Content="Newest first" Tag="NewestFirst"/>
                                    <ComboBoxItem Content="Oldest first" Tag="OldestFirst"/>
                                    <ComboBoxItem Content="Name A–Z"     Tag="NameAsc"/>
                                    <ComboBoxItem Content="Name Z–A"     Tag="NameDesc"/>
                                    <ComboBoxItem Content="Largest first" Tag="SizeDesc"/>
                                    <ComboBoxItem Content="Smallest first" Tag="SizeAsc"/>
                                </ComboBox>
                                <Button x:Name="GalleryRefreshBtn" Content="↻"
                                        ToolTip="Rescan the folder (F5)"
                                        Style="{StaticResource Ghost}" Margin="8,0,0,0"
                                        Click="GalleryRefresh_Click"/>
                            </StackPanel>

                            <!-- Search sits between the title and the sort controls -->
                            <Border Margin="16,0,16,0" MaxWidth="280"
                                    Background="{DynamicResource Brush.Input}"
                                    BorderBrush="{DynamicResource Brush.BorderInput}"
                                    BorderThickness="1" CornerRadius="6">
                                <DockPanel>
                                    <TextBlock Text="🔍" Margin="8,0,4,0" FontSize="12"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.TextMuted}"/>
                                    <Button x:Name="SearchClearBtn" DockPanel.Dock="Right"
                                            Content="✕" Style="{StaticResource Ghost}"
                                            Padding="6,2" Visibility="Collapsed"
                                            Click="SearchClear_Click"/>
                                    <TextBox x:Name="GallerySearchBox" BorderThickness="0"
                                             Background="Transparent" Padding="2,6,6,6"
                                             FontSize="12" VerticalContentAlignment="Center"
                                             ToolTip="File name"
                                             Foreground="{DynamicResource Brush.Text}"
                                             TextChanged="GallerySearch_Changed"/>
                                </DockPanel>
                            </Border>
                        </DockPanel>

                        <!-- Filters: text search inside images, and a date range -->
                        <DockPanel Margin="0,10,0,0">
                            <CheckBox x:Name="OcrSearchChk" VerticalAlignment="Center"
                                      Content="Search text inside images"
                                      ToolTip="Reads the words in each capture so you can search for them"
                                      Checked="OcrSearch_Toggled" Unchecked="OcrSearch_Toggled"/>

                            <!-- Its own box: mixing "find a file called X" with "find a
                                 picture containing X" in one field makes it impossible to
                                 tell which kind of match you got. -->
                            <Border x:Name="TextSearchBox" Margin="12,0,0,0" Width="240"
                                    Visibility="Collapsed"
                                    Background="{DynamicResource Brush.Input}"
                                    BorderBrush="{DynamicResource Brush.BorderInput}"
                                    BorderThickness="1" CornerRadius="6">
                                <DockPanel>
                                    <TextBlock Text="🔤" Margin="8,0,4,0" FontSize="12"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.TextMuted}"/>
                                    <Button x:Name="TextSearchClearBtn" DockPanel.Dock="Right"
                                            Content="✕" Style="{StaticResource Ghost}"
                                            Padding="6,2" Visibility="Collapsed"
                                            Click="TextSearchClear_Click"/>
                                    <TextBox x:Name="OcrSearchInput" BorderThickness="0"
                                             Background="Transparent" Padding="2,5,6,5"
                                             FontSize="12" VerticalContentAlignment="Center"
                                             ToolTip="Words to look for inside the pictures"
                                             Foreground="{DynamicResource Brush.Text}"
                                             TextChanged="TextSearch_Changed"/>
                                </DockPanel>
                            </Border>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                        Margin="16,0,0,0">
                                <TextBlock Text="Dates" VerticalAlignment="Center" FontSize="12"
                                           Margin="0,0,6,0"
                                           Foreground="{DynamicResource Brush.TextMuted}"/>
                                <ComboBox x:Name="DateRangeCombo" Width="140" FontSize="12"
                                          VerticalContentAlignment="Center"
                                          SelectionChanged="DateRange_Changed">
                                    <ComboBoxItem Content="Any time"     Tag="Any"/>
                                    <ComboBoxItem Content="Today"        Tag="Today"/>
                                    <ComboBoxItem Content="Yesterday"    Tag="Yesterday"/>
                                    <ComboBoxItem Content="Last 7 days"  Tag="Week"/>
                                    <ComboBoxItem Content="Last 30 days" Tag="Month"/>
                                    <ComboBoxItem Content="This year"    Tag="Year"/>
                                    <ComboBoxItem Content="Custom range" Tag="Custom"/>
                                </ComboBox>

                                <StackPanel x:Name="CustomRangePanel" Orientation="Horizontal"
                                            Visibility="Collapsed" Margin="8,0,0,0">
                                    <DatePicker x:Name="DateFrom" Width="122" FontSize="12"
                                                SelectedDateChanged="CustomDate_Changed"/>
                                    <TextBlock Text="→" VerticalAlignment="Center" Margin="6,0"
                                               Foreground="{DynamicResource Brush.TextMuted}"/>
                                    <DatePicker x:Name="DateTo" Width="122" FontSize="12"
                                                SelectedDateChanged="CustomDate_Changed"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Fills whatever is left, and is the element that gets
                                 trimmed rather than pushing the date controls off. -->
                            <!-- A bar as well as the count. Reading a folder of captures is
                                 a minutes-long job, and a number that changes every few
                                 seconds does not read as motion — which is what makes a
                                 long job feel stalled. Docked left of the fill so it keeps
                                 its width while the status text takes the trimming. -->
                            <ProgressBar x:Name="OcrProgressBar" DockPanel.Dock="Left"
                                         Width="120" Height="6" Margin="12,0,0,0"
                                         VerticalAlignment="Center" Visibility="Collapsed"
                                         Minimum="0" Maximum="1"
                                         Background="{DynamicResource Brush.Subtle}"
                                         BorderThickness="0"
                                         Foreground="{DynamicResource Brush.Accent}"/>

                            <TextBlock x:Name="OcrStatusText" VerticalAlignment="Center"
                                       Margin="10,0,0,0" FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Brush.TextMuted}"/>
                        </DockPanel>

                        <!-- Selection-aware action row -->
                        <DockPanel Margin="0,10,0,0">
                            <TextBlock x:Name="GallerySelectionText" VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource Brush.TextFaint}"/>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="GallerySelectAllBtn" Content="Select all"
                                        Style="{StaticResource Ghost}" Margin="0,0,6,0"
                                        Click="GallerySelectAll_Click"/>
                                <Button x:Name="GalleryClearSelBtn" Content="Clear"
                                        Style="{StaticResource Ghost}" Margin="0,0,6,0"
                                        Click="GalleryClearSelection_Click"/>
                                <Rectangle Width="1" Margin="4,4" 
                                           Fill="{DynamicResource Brush.Border}"/>
                                <Button x:Name="GalleryEditBtn" Content="✎ Edit"
                                        Style="{StaticResource Ghost}" Margin="6,0,6,0"
                                        Click="GalleryEdit_Click" IsEnabled="False"/>
                                <Button x:Name="GalleryConvertToPdfBtn" Content="📄 Convert to PDF"
                                        Style="{StaticResource Ghost}" Margin="0,0,6,0"
                                        Click="GalleryConvertToPdf_Click" Visibility="Collapsed"
                                        ToolTip="Combine the selected images into a single PDF document"/>
                                <Button x:Name="GalleryPlayBtn" Content="▶ Open"
                                        Style="{StaticResource Ghost}" Margin="0,0,6,0"
                                        Visibility="Collapsed"
                                        Click="GalleryPlay_Click" IsEnabled="False"
                                        ToolTip="Play, trim and export this recording"/>
                                <Button x:Name="GalleryCopyBtn" Content="Copy to Clipboard"
                                        Style="{StaticResource Ghost}" Margin="0,0,6,0"
                                        Click="GalleryAddToHistory_Click" IsEnabled="False"
                                        ToolTip="Add selected image(s) or PDF(s) to clipboard history"/>
                                <Button x:Name="GalleryDeleteBtn" Content="🗑 Delete"
                                        Style="{StaticResource Ghost}" Margin="0,0,6,0"
                                        Click="GalleryDelete_Click" IsEnabled="False"/>
                                <Rectangle Width="1" Margin="4,4" 
                                           Fill="{DynamicResource Brush.Border}"/>
                                <Button x:Name="GalleryOpenFolderBtn" Content="Open folder"
                                        Style="{StaticResource Ghost}" Margin="6,0,6,0"
                                        Click="GalleryOpenFolder_Click"/>
                                <Button x:Name="GalleryOpenImageBtn" Content="Open Editor"
                                        Style="{StaticResource Ghost}" Margin="0,0,0,0"
                                        Click="GalleryOpenExternal_Click"
                                        ToolTip="Open the editor or edit a picture from anywhere on this PC"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Thumbnail grid.
                     No outer ScrollViewer here, deliberately. One around the list gives it
                     unbounded height, and a panel measured against infinity realizes every
                     item however virtualized it claims to be. The ListBox scrolls itself. -->
                <Grid Grid.Row="1" Margin="6">
                        <StackPanel x:Name="GalleryEmpty" HorizontalAlignment="Center"
                                    VerticalAlignment="Center" Margin="0,60,0,0">
                            <TextBlock x:Name="GalleryEmptyTitle" Text="No snips yet"
                                       FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.TextMuted}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="GalleryEmptyHint"
                                       Text="Press your snip hotkey to capture a region."
                                       Foreground="{DynamicResource Brush.TextMuted}"
                                       FontSize="13" Margin="0,6,0,0"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <ListBox x:Name="GalleryList"
                                 Background="Transparent" BorderThickness="0"
                                 SelectionMode="Extended"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 ItemContainerStyle="{StaticResource GalleryItem}"
                                 SelectionChanged="GalleryList_SelectionChanged"
                                 MouseDoubleClick="GalleryList_DoubleClick"
                                 KeyDown="GalleryList_KeyDown"
                                 ContextMenuOpening="GalleryContextMenu_Opening">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <vwp:VirtualizingWrapPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="180" Margin="0">
                                        <Border CornerRadius="8,8,0,0" ClipToBounds="True"
                                                Background="{DynamicResource Brush.Subtle}"
                                                Height="120">
                                            <Grid>
                                                <!-- Placeholder shows until the decoder
                                                     gets to this item. -->
                                                <TextBlock Text="…" FontSize="20"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Brush.TextMuted}"/>
                                                <Image Source="{Binding Thumb}"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="LowQuality"/>

                                                <!-- Only videos carry a duration, so the
                                                     badge keys off the text rather than a
                                                     second flag that could disagree with it. -->
                                                <Border Background="#B2000000" CornerRadius="4"
                                                        Padding="5,1" Margin="0,0,6,6"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        Visibility="{Binding DurationVisibility}">
                                                    <TextBlock Text="{Binding DurationLabel}"
                                                               Foreground="White" FontSize="10.5"
                                                               FontWeight="SemiBold"/>
                                                </Border>

                                                <Border Background="#59000000" CornerRadius="16"
                                                        Width="32" Height="32"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding PlayBadgeVisibility}">
                                                    <TextBlock Text="▶" Foreground="White"
                                                               FontSize="13"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <StackPanel Margin="10,8,10,10">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.TextHeading}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding FilePath}"/>
                                            <TextBlock Text="{Binding SubtitleLabel}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource Brush.TextMuted}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem x:Name="MenuPin" Header="Pin to screen"
                                              Click="GalleryPin_Click">
                                        <MenuItem.Icon>
                                            <TextBlock Text="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       Foreground="{DynamicResource Brush.Accent}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem x:Name="MenuEdit" Header="Edit…"
                                              Click="GalleryEdit_Click"/>
                                    <MenuItem x:Name="MenuConvertToPdf" Header="Convert to PDF…"
                                              Click="GalleryConvertToPdf_Click" Visibility="Collapsed"/>
                                    <MenuItem x:Name="MenuOpenWith" Header="Play / trim…"
                                              Click="GalleryPlay_Click"/>
                                    <MenuItem x:Name="MenuAddToHistory"
                                              Header="Add to clipboard history"
                                              Click="GalleryAddToHistory_Click"/>
                                    <MenuItem x:Name="MenuOpenFile" Header="Open file" Click="GalleryOpenFile_Click"/>
                                    <MenuItem Header="Show in Explorer"  Click="GalleryShowInExplorer_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Select all"        Click="GallerySelectAll_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Delete"            Click="GalleryDelete_Click"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                    </Grid>

                <!-- Status bar doubles as the pager -->
                <Border Grid.Row="2" Background="{DynamicResource Brush.Card}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="0,1,0,0" Padding="16,7">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                    x:Name="GalleryPager">
                            <Button x:Name="GalleryPrevBtn" Content="‹ Previous"
                                    Style="{StaticResource Ghost}" Padding="10,3"
                                    Click="GalleryPrev_Click"/>
                            <TextBlock x:Name="GalleryPageText" VerticalAlignment="Center"
                                       Margin="10,0" FontSize="12"
                                       Foreground="{DynamicResource Brush.TextFaint}"/>
                            <Button x:Name="GalleryNextBtn" Content="Next ›"
                                    Style="{StaticResource Ghost}" Padding="10,3"
                                    Click="GalleryNext_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="GalleryStatus" Text="Loading…"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextMuted}" FontSize="12"/>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ─── SETTINGS ─── -->
            <ScrollViewer x:Name="PageRecord" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" Padding="28,24">
                <StackPanel MaxWidth="660" HorizontalAlignment="Left">

                    <TextBlock Text="Screen recording" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.TextHeading}"/>
                    <TextBlock Text="Records to H.264 MP4 using the encoder built into Windows, so files stay small and any hardware encoder on the machine is used automatically."
                               Foreground="{DynamicResource Brush.TextMuted}" FontSize="12.5"
                               TextWrapping="Wrap" Margin="0,6,0,18"/>

                    <!-- This page is the launcher and nothing else; every recording setting
                         now lives under Settings ▸ Recording. Two pages that both held
                         settings meant neither was where anyone looked first. What stays
                         here is a plain statement of what pressing the button will do, so
                         the settings need not be visited to be trusted. -->
                    <Border Background="{DynamicResource Brush.Card}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1" CornerRadius="10" Padding="20,18">
                        <StackPanel>
                            <TextBlock Text="READY TO RECORD" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.TextFaint}"
                                       Margin="0,0,0,14"/>

                            <TextBlock x:Name="RecordSummaryLine" FontSize="15" FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Brush.TextHeading}"/>
                            <TextBlock x:Name="RecordEstimateTitle" FontSize="12.5" Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Brush.TextBody}"/>
                            <TextBlock x:Name="RecordEstimateDetail" FontSize="12" TextWrapping="Wrap"
                                       Margin="0,4,0,0"
                                       Foreground="{DynamicResource Brush.TextMuted}"/>
                            <TextBlock x:Name="RecordDestinationLine" FontSize="12" Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Brush.TextMuted}"/>

                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <Button x:Name="RecordStartBtn" Style="{StaticResource Primary}"
                                        Content="Start recording" Padding="22,9"
                                        Click="RecordStart_Click"/>
                                <Button x:Name="ReviewLastBtn" Style="{StaticResource Ghost}"
                                        Content="Review last" Margin="10,0,0,0"
                                        Click="ReviewLast_Click"
                                        ToolTip="Open the most recent recording to play, trim and export"/>
                                <Button x:Name="RecordSettingsBtn" Style="{StaticResource Ghost}"
                                        Content="Settings" Margin="6,0,0,0"
                                        Click="RecordSettings_Click"
                                        ToolTip="Source, sound, quality and where recordings are saved"/>
                                <TextBlock x:Name="RecordStatusText" VerticalAlignment="Center"
                                           Margin="14,0,0,0" FontSize="12.5"
                                           Foreground="{DynamicResource Brush.Danger}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>


                    <TextBlock Text="While recording, a small toolbar appears with Stop, Pause, Undo and Clear. Press Ctrl+Shift+A for the tool picker wherever your pointer is — pen, marker, arrow, box, circle, spotlight, numbered steps — then 1 to 9 to choose one, or pin the picker to keep it open all recording. With the pen out you mostly do not need to switch at all: hold Shift for a line, Ctrl for an arrow, Ctrl+Shift for a box, and roll the wheel for stroke width or Shift+wheel for colour. Neither the toolbar, the picker nor the drawing overlay is captured: only your screen and what you draw."
                               FontSize="11" TextWrapping="Wrap" Margin="0,14,0,0"
                               Foreground="{DynamicResource Brush.TextMuted}"/>
                </StackPanel>
            </ScrollViewer>


            <Grid x:Name="PageSettings" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Eight unrelated sections in one scroll is a page where nothing can be
                     found. Splitting them behind a segmented header costs one click and
                     puts recording settings somewhere a person would actually look for
                     them, instead of on the page you press to start recording. -->
                <Border Grid.Row="0" Background="{DynamicResource Brush.Card}"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                        Padding="16,10">
                    <StackPanel>
                        <TextBlock Text="Settings" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <RadioButton x:Name="SetTabCapture" Style="{StaticResource SubTab}"
                                         GroupName="SettingsTab" IsChecked="True"
                                         Content="Capture" Checked="SettingsTab_Checked"/>
                            <RadioButton x:Name="SetTabRecording" Style="{StaticResource SubTab}"
                                         GroupName="SettingsTab"
                                         Content="Recording" Checked="SettingsTab_Checked"/>
                            <RadioButton x:Name="SetTabGallery" Style="{StaticResource SubTab}"
                                         GroupName="SettingsTab"
                                         Content="Gallery" Checked="SettingsTab_Checked"/>
                            <RadioButton x:Name="SetTabHotkeys" Style="{StaticResource SubTab}"
                                         GroupName="SettingsTab"
                                         Content="Shortcuts" Checked="SettingsTab_Checked"/>
                            <RadioButton x:Name="SetTabGeneral" Style="{StaticResource SubTab}"
                                         GroupName="SettingsTab"
                                         Content="General" Checked="SettingsTab_Checked"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ScrollViewer x:Name="SettingsScroller" Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="28,20">
                    <StackPanel MaxWidth="660" HorizontalAlignment="Left">

                        <StackPanel x:Name="SetPaneCapture">
                        

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="CAPTURE" Style="{StaticResource CardHead}"/>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="Save folder" Style="{StaticResource FieldLabel}"/>
