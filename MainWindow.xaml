                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource HelpKey}" Margin="12,0,0,0" Text="Ctrl+Shift+S"/>
                                <TextBlock Style="{StaticResource HelpP}" Margin="0" Text="Take a snip"/>
