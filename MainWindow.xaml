                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource HelpH}" Text="Clipboard history HUD" Margin="0,0,0,10"/>
                            <TextBlock Style="{StaticResource HelpP}" Text="Press Ctrl+Shift+V for a horizontal strip of recent captures. Use ← / → or mouse wheel to navigate, Space to preview full-size, Enter to paste into the active window, and Esc to close."/>
                            <TextBlock Style="{StaticResource HelpP}" Text="Ctrl+Shift+. (Next) and Ctrl+Shift+, (Previous) cycle and paste history items directly without opening any popup window."/>
                        </StackPanel>
                    </Border>

