                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                <Button Content="Clear snip history" Style="{StaticResource Ghost}"
                                        Click="ClearBtn_Click" Margin="0,0,10,0"/>
                                <Button Content="Save settings" Click="SaveBtn_Click"
                                        Padding="18,8" Background="{DynamicResource Brush.Accent}" Foreground="{DynamicResource Brush.OnAccent}"
                                        BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="13"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ─── ABOUT ─── -->
            <ScrollViewer x:Name="PageHelp" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch">
                <!-- MaxWidth keeps line lengths readable at ultrawide resolutions.
                     Left-aligned with a generous margin so it reads like a document
                     rather than a centred splash screen. -->
                <StackPanel Margin="40,36,40,48" MaxWidth="780" HorizontalAlignment="Left">
                    <TextBlock Text="✂ Advanced Snip" FontSize="26" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Text}"/>
                    <TextBlock x:Name="HelpVersion" Text="Version 3.0.0 by Ankit Mishra"
                               Foreground="{DynamicResource Brush.TextFaint}" FontSize="13"
                               Margin="0,4,0,18"/>
                    <TextBlock Style="{StaticResource HelpP}"
                               Text="Fast, privacy-first screen capture, video recording, annotation, and document export. Everything runs 100% locally on your machine with zero cloud telemetry or background tracking."/>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource HelpH}" Text="Start here" Margin="0,0,0,10"/>
                            <TextBlock Style="{StaticResource HelpP}" Text="The title bar carries the main actions — Snip, Scroll, Record, OCR and History. Each is reachable globally via hotkeys even when the window is minimized. The Clear button safely empties the clipboard history with confirmation."/>
                            <TextBlock Style="{StaticResource HelpP}" Text="The system tray icon provides instant access to Snip, Record, OCR, and Settings, and dynamically adapts to your chosen color theme."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource HelpH}" Text="Capture a region" Margin="0,0,0,10"/>
                            <TextBlock Style="{StaticResource HelpP}" Text="Press Ctrl+Shift+S, then drag a rectangle — or click once on any window to capture it. A pixel-precise magnifier assists with exact edge alignment. Esc cancels."/>
                            <TextBlock Style="{StaticResource HelpP}" Text="Captures are automatically saved to your gallery and copied to the Windows clipboard. Click the notification toast to open directly in the editor."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource HelpH}" Text="Real-Time Screen OCR Reader" Margin="0,0,0,10"/>
                            <TextBlock Style="{StaticResource HelpP}" Text="Press Ctrl+Shift+O, or click the OCR button in the title bar. Drag a selection across any text on your screen (web pages, error popups, terminal windows, code, images, remote desktops) to extract and copy text instantly without saving screenshot files."/>
                            <TextBlock Style="{StaticResource HelpP}" Text="• Quick Format Chips: Single line (merges wrapped lines for prompts/URLs), No spaces (for serials, keys, and tokens), UPPER, lower, and Title Case."/>
                            <TextBlock Style="{StaticResource HelpP}" Text="• Power Tools: Auto-detects web URLs with a 1-click 'Open Link' button, Google Search, Google Translate, Monospace/Prose font toggle (&lt;/&gt;), and '↺ New OCR' to immediately capture another region."/>
                            <TextBlock Style="{StaticResource HelpP}" Text="• Resizable &amp; Pinnable: Drag any edge or corner to resize the floating card, or click the Pin button to keep it floating above other windows."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource HelpH}" Text="Capture a whole scrolling page" Margin="0,0,0,10"/>
                            <TextBlock Style="{StaticResource HelpP}" Text="Press Ctrl+Shift+W and click any scrollable area — a browser, document, chat thread, or file tree. The app scrolls smoothly, computes actual content displacement, detects fixed sticky headers, and stitches the entire view into one seamless tall image."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource HelpH}" Text="Record the screen &amp; live annotation" Margin="0,0,0,10"/>
