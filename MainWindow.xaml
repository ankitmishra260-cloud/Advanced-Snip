                                <TextBlock Style="{StaticResource HelpP}" Margin="0" Text="Arrow"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource HelpKey}" Margin="12,0,0,0" Text="hold Ctrl + Shift"/>
                                <TextBlock Style="{StaticResource HelpP}" Margin="0" Text="Box"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource HelpP}" Text="Wheel adjusts stroke width, Shift+Wheel changes colors, and Ctrl+Wheel zooms live into the screen. Completed recordings open in the built-in video player with frame trimming and clip export."/>
