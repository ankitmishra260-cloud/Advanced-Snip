                                              SelectionChanged="Theme_Changed">
                                        <ComboBoxItem Content="Match Windows"               Tag="System"/>
                                        <ComboBoxItem Content="Classic Light"               Tag="Light"/>
                                        <ComboBoxItem Content="Classic Dark"                Tag="Dark"/>
                                        <ComboBoxItem Content="Purple Neon (Light)"         Tag="LightNeon"/>
                                        <ComboBoxItem Content="Purple Neon (Dark)"          Tag="DarkNeon"/>
                                        <ComboBoxItem Content="Blue Neon (Light)"           Tag="BlueNeonLight"/>
                                        <ComboBoxItem Content="Blue Neon (Dark)"            Tag="BlueNeon"/>
                                        <ComboBoxItem Content="Sunset Amber"                Tag="Sunset"/>
                                        <ComboBoxItem Content="Cyan Neon"                           Tag="Cyberpunk"/>
                                        <ComboBoxItem Content="Emerald Matrix (Cyber-Green)"        Tag="EmeraldMatrix"/>
                                        <ComboBoxItem Content="Solar Flare (Gold &amp; Crimson)"    Tag="SolarFlare"/>
                                        <ComboBoxItem Content="Rose Quartz (Blush &amp; Gold)"      Tag="RoseQuartz"/>
                                        <ComboBoxItem Content="Midnight Amethyst (Royal Violet)"    Tag="MidnightAmethyst"/>
                                        <ComboBoxItem Content="Quantum Obsidian (Bioluminescent)"   Tag="PrismAurora"/>
                                    </ComboBox>
                                </DockPanel>
                                <TextBlock Text="Match Windows follows the system setting live, including its light/dark schedule."
                                           Foreground="{DynamicResource Brush.TextMuted}" FontSize="11"
                                           Margin="0,0,0,4"/>

                                <!-- GALLERY -->
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="NOTIFICATIONS" Style="{StaticResource CardHead}"/>
                                <CheckBox x:Name="NotifyChk" Foreground="{DynamicResource Brush.TextBody}"
                                          Content="Show tray notification after each snip"/>
                                <CheckBox x:Name="EditOnClickChk" Foreground="{DynamicResource Brush.TextBody}"
                                          Margin="0,8,0,0"
                                          Content="Clicking that notification opens the capture for editing"/>

                                <!-- HOTKEYS -->
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="STARTUP &amp; WINDOW" Style="{StaticResource CardHead}"/>
                                <CheckBox x:Name="StartupChk" Foreground="{DynamicResource Brush.TextBody}"
                                          Content="Start Advanced Snip when I sign in to Windows"
                                          Checked="Startup_Toggled" Unchecked="Startup_Toggled"/>

                                <!-- Rather than assume the registry write worked, this reports what
                                     Windows will actually do at the next sign-in. -->
                                <Border x:Name="StartupStatusPanel" Margin="24,8,0,0" Padding="10,7"
                                        CornerRadius="6"
                                        Background="{DynamicResource Brush.Subtle}"
                                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
