                            </DockPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource HelpKey}" Margin="12,0,0,0" Text="Ctrl+Shift+W"/>
                                <TextBlock Style="{StaticResource HelpP}" Margin="0" Text="Scroll capture a window"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource HelpKey}" Margin="12,0,0,0" Text="Ctrl+Shift+V"/>
                                <TextBlock Style="{StaticResource HelpP}" Margin="0" Text="Clipboard history HUD"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource HelpKey}" Margin="12,0,0,0" Text="Ctrl+Shift+."/>
                                <TextBlock Style="{StaticResource HelpP}" Margin="0" Text="Next image + paste"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource HelpKey}" Margin="12,0,0,0" Text="Ctrl+Shift+,"/>
                                <TextBlock Style="{StaticResource HelpP}" Margin="0" Text="Previous image + paste"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource HelpP}" Text="While recording: Ctrl+Shift+A tool picker · P pen · M marker · X arrow · F spotlight · B hide · N step · Z undo · E erase all · U mute · + / − / 0 zoom. All shortcuts can be customized in Settings ▸ Shortcuts."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource HelpH}" Text="Troubleshooting &amp; tips" Margin="0,0,0,10"/>
                            <TextBlock Style="{StaticResource HelpP}" Text="Programmatic paste: If a third-party application blocks simulated keystrokes, the image remains ready on your clipboard — press Ctrl+V to paste."/>
                            <TextBlock Style="{StaticResource HelpP}" Text="Text search: Offline OCR uses Windows language packs. Install additional languages in Windows Settings ▸ Time &amp; Language to index non-English text."/>
                            <TextBlock Style="{StaticResource HelpP}" Text="Per-Monitor DPI: The app is fully Per-Monitor V2 DPI aware; captures and toasts align precisely across mixed display scales."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

        </Grid><!-- end content area -->
