                                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextBody}" FontSize="13"
                                               MinWidth="32" Margin="8,0,0,0"
                                               Text="{Binding ElementName=OpacitySlider, Path=Value, StringFormat={}{0:0}%}"/>
