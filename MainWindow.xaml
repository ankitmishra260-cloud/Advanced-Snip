                                <CheckBox x:Name="ScrollAutoRegionChk" Foreground="{DynamicResource Brush.TextBody}" Margin="0,4,0,0"
                                          Content="Detect the scrolling area automatically (skips toolbars and sticky headers)"/>
                                <CheckBox x:Name="ScrollRestoreChk" Foreground="{DynamicResource Brush.TextBody}" Margin="0,8,0,0"
                                          Content="Put the window back where it was scrolled to afterwards"/>

                                <!-- CLIPBOARD -->
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="SetPaneRecording" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="WHAT TO RECORD" Style="{StaticResource CardHead}"/>

                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Left" Width="130" Text="Source"
                                           VerticalAlignment="Center" FontSize="13"
                                           Foreground="{DynamicResource Brush.TextBody}"/>
                                <ComboBox x:Name="RecordSourceCombo" Width="260"
                                          HorizontalAlignment="Left"
                                          SelectionChanged="RecordSource_Changed">
                                    <ComboBoxItem Content="The monitor the pointer is on" Tag="Monitor"/>
                                    <ComboBoxItem Content="Everything (all monitors)" Tag="Screen"/>
                                    <ComboBoxItem Content="Pick a region each time" Tag="Region"/>
                                    <ComboBoxItem Content="Pick a window each time" Tag="Window"/>
                                </ComboBox>
                            </DockPanel>

                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Left" Width="130" Text="Countdown"
                                           VerticalAlignment="Center" FontSize="13"
                                           Foreground="{DynamicResource Brush.TextBody}"/>
                                <ComboBox x:Name="RecordCountdownCombo" Width="260"
                                          HorizontalAlignment="Left"
                                          SelectionChanged="RecordCountdown_Changed">
                                    <ComboBoxItem Content="None — start immediately" Tag="0"/>
                                    <ComboBoxItem Content="3 seconds" Tag="3"/>
                                    <ComboBoxItem Content="5 seconds" Tag="5"/>
                                    <ComboBoxItem Content="10 seconds" Tag="10"/>
                                </ComboBox>
                            </DockPanel>

                            <CheckBox x:Name="RecordCursorChk" Content="Include the mouse pointer"
                                      Margin="0,0,0,8" Foreground="{DynamicResource Brush.TextBody}"
                                      Checked="RecordToggle_Changed" Unchecked="RecordToggle_Changed"/>
                            <CheckBox x:Name="RecordInkChk"
                                      Content="Show the drawing tools, so you can annotate the screen while recording"
                                      Foreground="{DynamicResource Brush.TextBody}"
                                      Checked="RecordToggle_Changed" Unchecked="RecordToggle_Changed"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="SOUND" Style="{StaticResource CardHead}"/>

                            <CheckBox x:Name="RecordSystemAudioChk"
                                      Content="Record what this computer is playing"
                                      Margin="0,0,0,8"
                                      Foreground="{DynamicResource Brush.TextBody}"
                                      Checked="RecordAudio_Changed" Unchecked="RecordAudio_Changed"/>

                            <DockPanel Margin="24,0,0,10">
                                <TextBlock DockPanel.Dock="Left" Width="106" Text="Device"
                                           VerticalAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource Brush.TextMuted}"/>
                                <ComboBox x:Name="SystemAudioCombo" Width="300"
                                          HorizontalAlignment="Left"
                                          SelectionChanged="AudioDevice_Changed"/>
                            </DockPanel>

                            <DockPanel Margin="24,0,0,14">
                                <TextBlock DockPanel.Dock="Left" Width="106" Text="Level"
                                           VerticalAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource Brush.TextMuted}"/>
                                <ComboBox x:Name="SystemVolumeCombo" Width="140"
                                          HorizontalAlignment="Left"
                                          SelectionChanged="AudioVolume_Changed">
                                    <ComboBoxItem Content="25%"  Tag="25"/>
                                    <ComboBoxItem Content="50%"  Tag="50"/>
                                    <ComboBoxItem Content="75%"  Tag="75"/>
                                    <ComboBoxItem Content="100%" Tag="100"/>
                                    <ComboBoxItem Content="150%" Tag="150"/>
                                    <ComboBoxItem Content="200%" Tag="200"/>
                                </ComboBox>
                            </DockPanel>

                            <CheckBox x:Name="RecordMicChk"
                                      Content="Record the microphone"
                                      Margin="0,0,0,8"
                                      Foreground="{DynamicResource Brush.TextBody}"
                                      Checked="RecordAudio_Changed" Unchecked="RecordAudio_Changed"/>

                            <DockPanel Margin="24,0,0,10">
                                <TextBlock DockPanel.Dock="Left" Width="106" Text="Device"
                                           VerticalAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource Brush.TextMuted}"/>
                                <ComboBox x:Name="MicAudioCombo" Width="300"
                                          HorizontalAlignment="Left"
                                          SelectionChanged="AudioDevice_Changed"/>
                            </DockPanel>

                            <DockPanel Margin="24,0,0,4">
                                <TextBlock DockPanel.Dock="Left" Width="106" Text="Level"
                                           VerticalAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource Brush.TextMuted}"/>
                                <ComboBox x:Name="MicVolumeCombo" Width="140"
                                          HorizontalAlignment="Left"
                                          SelectionChanged="AudioVolume_Changed">
                                    <ComboBoxItem Content="25%"  Tag="25"/>
                                    <ComboBoxItem Content="50%"  Tag="50"/>
                                    <ComboBoxItem Content="75%"  Tag="75"/>
                                    <ComboBoxItem Content="100%" Tag="100"/>
                                    <ComboBoxItem Content="150%" Tag="150"/>
                                    <ComboBoxItem Content="200%" Tag="200"/>
                                </ComboBox>
                            </DockPanel>

                            <TextBlock x:Name="AudioHintText" FontSize="11" TextWrapping="Wrap"
                                       Margin="0,12,0,0"
                                       Foreground="{DynamicResource Brush.TextFaint}"
                                       Text="Sound is recorded into the same MP4 as AAC. Mute mid-recording with Ctrl+Shift+U. Leaving a device set to the default means it follows whatever Windows is using, which keeps working when a headset is unplugged."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="QUALITY AND SIZE" Style="{StaticResource CardHead}"/>

                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Left" Width="130" Text="Quality"
                                           VerticalAlignment="Center" FontSize="13"
                                           Foreground="{DynamicResource Brush.TextBody}"/>
                                <ComboBox x:Name="RecordQualityCombo" Width="260"
                                          HorizontalAlignment="Left"
                                          SelectionChanged="RecordQuality_Changed">
                                    <ComboBoxItem Content="Efficient — smallest files" Tag="Efficient"/>
                                    <ComboBoxItem Content="Balanced — recommended" Tag="Balanced"/>
                                    <ComboBoxItem Content="High — crisp text and detail" Tag="High"/>
                                    <ComboBoxItem Content="Maximum — for video and animation" Tag="Maximum"/>
                                </ComboBox>
                            </DockPanel>

                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Left" Width="130" Text="Frame rate"
                                           VerticalAlignment="Center" FontSize="13"
                                           Foreground="{DynamicResource Brush.TextBody}"/>
                                <ComboBox x:Name="RecordFpsCombo" Width="260"
                                          HorizontalAlignment="Left"
                                          SelectionChanged="RecordFps_Changed">
                                    <ComboBoxItem Content="10 fps — slides and static screens" Tag="10"/>
                                    <ComboBoxItem Content="15 fps — demos and walkthroughs" Tag="15"/>
                                    <ComboBoxItem Content="24 fps" Tag="24"/>
                                    <ComboBoxItem Content="30 fps — smooth, the usual choice" Tag="30"/>
                                    <ComboBoxItem Content="60 fps — motion and gameplay" Tag="60"/>
                                </ComboBox>
                            </DockPanel>

                            <Border Background="{DynamicResource Brush.Subtle}" CornerRadius="8"
                                    Padding="14,12">
                                <StackPanel>
                                    <TextBlock x:Name="QualityEstimateTitle" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.TextHeading}"/>
                                    <TextBlock x:Name="QualityEstimateDetail" FontSize="12" TextWrapping="Wrap"
                                               Margin="0,4,0,0"
                                               Foreground="{DynamicResource Brush.TextFaint}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="WHERE TO SAVE" Style="{StaticResource CardHead}"/>
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Content="Browse…" Style="{StaticResource Ghost}"
                                        Margin="8,0,0,0" Click="VideoFolder_Click"/>
                                <TextBox x:Name="VideoFolderBox" IsReadOnly="True"
                                         TextChanged="VideoFolder_Changed"/>
                            </DockPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Width="130" Text="File name starts with"
                                           VerticalAlignment="Center" FontSize="13" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Brush.TextBody}"/>
                                <TextBox x:Name="VideoPrefixBox" Width="200" HorizontalAlignment="Left"
                                         TextChanged="VideoPrefix_Changed"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                        </StackPanel>

                        <StackPanel x:Name="SetPaneGallery" Visibility="Collapsed">
                        

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="GALLERY" Style="{StaticResource CardHead}"/>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="Thumbnails per page" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="PageSizeValue" DockPanel.Dock="Right" MinWidth="46"
                                               VerticalAlignment="Center" TextAlignment="Right"
                                               Foreground="{DynamicResource Brush.TextBody}"/>
                                    <Slider x:Name="PageSizeSlider" Minimum="50" Maximum="500" Width="200"
                                            IsSnapToTickEnabled="True" TickFrequency="25"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                            ValueChanged="PageSize_Changed"/>
                                </DockPanel>
                                <CheckBox x:Name="RecycleChk" Foreground="{DynamicResource Brush.TextBody}"
                                          Content="Send deleted captures to the Recycle Bin"/>

                                <!-- Text index maintenance. Lives here rather than on the gallery
                                     toolbar because it is a repair, not a daily action: indexing
                                     happens on its own and this is only wanted when it has gone
                                     wrong. A button that is needed twice a year does not earn a
                                     permanent place beside the ones needed twice a minute. -->
                                <TextBlock Text="Text search index" Style="{StaticResource FieldLabel}"
                                           Margin="0,18,0,4"/>
                                <TextBlock Text="Captures are read once and remembered. Rebuild if something you can clearly read in a picture never turns up in a search."
                                           Foreground="{DynamicResource Brush.TextMuted}" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="ReindexBtn" Style="{StaticResource Ghost}"
                                            Content="Rebuild index" Padding="12,4"
                                            Click="Reindex_Click"
                                            ToolTip="Read every capture again from scratch, ignoring what has already been indexed"/>
                                    <Button x:Name="ReindexCancelBtn" Style="{StaticResource Ghost}"
                                            Content="Stop" Margin="8,0,0,0" Padding="12,4"
                                            Visibility="Collapsed" Click="ReindexCancel_Click"
                                            ToolTip="Stop reading. Everything finished so far is kept."/>
                                    <TextBlock x:Name="ReindexStatusText" VerticalAlignment="Center"
                                               Margin="12,0,0,0" FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource Brush.TextMuted}"/>
                                </StackPanel>

                                <!-- NOTIFICATIONS -->
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="SetPaneHotkeys" Visibility="Collapsed">
                        

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="HOTKEYS" Style="{StaticResource CardHead}"/>
                                <TextBlock Text="Click a box then press the combination (must include Ctrl, Alt, Shift, or Win)."
                                           Foreground="{DynamicResource Brush.TextMuted}" FontSize="11" Margin="0,0,0,10"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Take a snip"              Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
                                    <TextBox   Grid.Row="0" Grid.Column="1" x:Name="SnipHotkeyBox"          Style="{StaticResource HotkeyBox}" Margin="0,0,0,8" GotFocus="Hotkey_GotFocus" PreviewKeyDown="Hotkey_PreviewKeyDown" Tag="Snip"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Take snip with timer"    Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
                                    <TextBox   Grid.Row="1" Grid.Column="1" x:Name="SnipTimerHotkeyBox"     Style="{StaticResource HotkeyBox}" Margin="0,0,0,8" GotFocus="Hotkey_GotFocus" PreviewKeyDown="Hotkey_PreviewKeyDown" Tag="SnipTimer"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Extract text / OCR"       Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
                                    <TextBox   Grid.Row="2" Grid.Column="1" x:Name="OcrHotkeyBox"           Style="{StaticResource HotkeyBox}" Margin="0,0,0,8" GotFocus="Hotkey_GotFocus" PreviewKeyDown="Hotkey_PreviewKeyDown" Tag="Ocr"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Start / stop recording"   Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
                                    <TextBox   Grid.Row="3" Grid.Column="1" x:Name="RecordHotkeyBox"        Style="{StaticResource HotkeyBox}" Margin="0,0,0,8" GotFocus="Hotkey_GotFocus" PreviewKeyDown="Hotkey_PreviewKeyDown" Tag="Record"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Scroll capture window"    Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
                                    <TextBox   Grid.Row="4" Grid.Column="1" x:Name="ScrollCaptureHotkeyBox" Style="{StaticResource HotkeyBox}" Margin="0,0,0,8" GotFocus="Hotkey_GotFocus" PreviewKeyDown="Hotkey_PreviewKeyDown" Tag="ScrollCapture"/>
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Show clipboard history"   Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
                                    <TextBox   Grid.Row="5" Grid.Column="1" x:Name="HistoryHotkeyBox"       Style="{StaticResource HotkeyBox}" Margin="0,0,0,8" GotFocus="Hotkey_GotFocus" PreviewKeyDown="Hotkey_PreviewKeyDown" Tag="History"/>
                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Next image + paste"       Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
                                    <TextBox   Grid.Row="6" Grid.Column="1" x:Name="NextHotkeyBox"          Style="{StaticResource HotkeyBox}" Margin="0,0,0,8" GotFocus="Hotkey_GotFocus" PreviewKeyDown="Hotkey_PreviewKeyDown" Tag="Next"/>
                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Previous image + paste"   Style="{StaticResource FieldLabel}"/>
                                    <TextBox   Grid.Row="7" Grid.Column="1" x:Name="PrevHotkeyBox"          Style="{StaticResource HotkeyBox}"                   GotFocus="Hotkey_GotFocus" PreviewKeyDown="Hotkey_PreviewKeyDown" Tag="Prev"/>
                                </Grid>

                                <CheckBox x:Name="ApplyTimerToSnipHotkeyChk" Foreground="{DynamicResource Brush.TextBody}" Margin="0,12,0,0"
                                          Content="Apply timer preset to main Snip hotkey (Ctrl+Shift+S)"/>

                                <!-- STARTUP -->
                                </StackPanel>
                            </Border>
                        </StackPanel>

