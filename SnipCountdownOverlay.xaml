<Window x:Class="AdvancedSnip.SnipCountdownOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snip Countdown"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        Focusable="False"
        ShowActivated="False"
        FontFamily="Segoe UI"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style x:Key="OverlayActionBtn" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SnapNowBtn" TargetType="Button" BasedOn="{StaticResource OverlayActionBtn}">
            <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6"
                                Background="{DynamicResource Brush.Accent}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CancelBtnStyle" TargetType="Button" BasedOn="{StaticResource OverlayActionBtn}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Themed container matching app style -->
    <Border CornerRadius="16"
            Background="{DynamicResource Brush.Card}"
            BorderBrush="{DynamicResource Brush.WindowEdge}"
            BorderThickness="1"
            Padding="14,9"
            MouseLeftButtonDown="Hud_Drag">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.45" Color="Black"/>
        </Border.Effect>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Pulsing/glowing countdown number ring -->
            <Border Width="36" Height="36" CornerRadius="18"
                    Background="{DynamicResource Brush.AccentSoft}"
                    BorderBrush="{DynamicResource Brush.Accent}"
                    BorderThickness="1.5"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center">
                <TextBlock x:Name="CountNumber"
                           Text="3"
                           FontSize="17"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Accent}"/>
            </Border>

            <!-- Status and label -->
            <StackPanel VerticalAlignment="Center" Margin="0,0,14,0" MinWidth="85">
                <TextBlock Text="SNIP IN"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Brush.TextMuted}"/>
                <TextBlock x:Name="StatusLabel"
                           Text="3 seconds..."
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.TextHeading}"
                           Margin="0,1,0,0"/>
            </StackPanel>

            <!-- Actions -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Snap now button -->
                <Button x:Name="SnapNowBtn"
                        Style="{StaticResource SnapNowBtn}"
                        Click="SnapNow_Click"
                        ToolTip="Capture now without waiting (Enter or Space)"
                        Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="12" Margin="0,0,5,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Snap now" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Cancel button -->
                <Button x:Name="CancelBtn"
                        Style="{StaticResource CancelBtnStyle}"
                        Click="Cancel_Click"
                        ToolTip="Cancel screenshot (Esc)">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                               FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
