<Window x:Class="AdvancedSnip.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clipboard history"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        PreviewMouseWheel="Window_PreviewMouseWheel">

    <Border CornerRadius="12"
            Background="#F01D2027"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            Padding="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="Black" />
        </Border.Effect>

        <StackPanel MinWidth="360" MaxWidth="900">
            <DockPanel Margin="2,0,2,10">
                <TextBlock Text="Clipboard history"
                           Foreground="White"
                           FontFamily="Segoe UI"
                           FontWeight="SemiBold"
                           FontSize="13" />
                <TextBlock x:Name="HintText"
                           DockPanel.Dock="Right"
                           HorizontalAlignment="Right"
                           Text="← →  or  wheel navigate   ·   Enter paste   ·   Esc close"
                           Foreground="#99FFFFFF"
                           FontFamily="Segoe UI"
                           FontSize="11" />
            </DockPanel>

            <ListBox x:Name="Thumbs"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     SelectionChanged="Thumbs_SelectionChanged"
                     MouseDoubleClick="Thumbs_MouseDoubleClick"
                     KeyDown="Thumbs_KeyDown">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="4" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Chrome"
                                            CornerRadius="8"
                                            Background="#22FFFFFF"
                                            BorderBrush="Transparent"
                                            BorderThickness="2"
                                            Padding="6">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#FF3B82F6" />
                                            <Setter TargetName="Chrome" Property="Background" Value="#333B82F6" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="Background" Value="#33FFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="160">
                            <Border CornerRadius="4" ClipToBounds="True" Background="#22000000">
                                <Image Source="{Binding Image}"
                                       Height="110"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <TextBlock Text="{Binding Caption}"
                                       Foreground="#CCFFFFFF"
                                       FontFamily="Segoe UI"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="EmptyText"
                       Text="No snips yet — press your snip hotkey to capture one."
                       Foreground="#99FFFFFF"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       Margin="4,10,4,6"
                       Visibility="Collapsed" />
        </StackPanel>
    </Border>
</Window>
