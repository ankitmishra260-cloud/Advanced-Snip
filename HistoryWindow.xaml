<Window x:Class="AdvancedSnip.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clipboard history"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        PreviewMouseWheel="Window_PreviewMouseWheel">

    <!-- **Themed, unlike the other floating panels.**
         The recording toolbar, the tool picker and the scroll-capture progress panel are
         still fixed dark: they are on screen *during* a capture, over arbitrary content,
         and two of them share the screen at once. The clipboard HUD is different in kind —
         you open it deliberately, from this app, to look at this app's own contents, so it
         reading as part of the app matters more than it standing apart from the desktop.
         The border and the shadow are kept strong so it still has an edge on a light
         background, which was the original worry. -->
    <Border CornerRadius="14"
            Background="{DynamicResource Brush.Card}"
            BorderBrush="{DynamicResource Brush.BorderStrong}"
            BorderThickness="1"
            Padding="16,14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.38" Color="Black" />
        </Border.Effect>

        <StackPanel MinWidth="360" MaxWidth="920">
            <DockPanel Margin="2,0,2,10">
                <TextBlock Text="Clipboard history"
                           Foreground="{DynamicResource Brush.Accent}"
                           FontFamily="Segoe UI"
                           FontWeight="SemiBold"
                           FontSize="13"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="HintText"
                           DockPanel.Dock="Right"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Text="← → scroll  ·  right-click edit  ·  P pin  ·  Enter paste  ·  Esc close"
                           Foreground="{DynamicResource Brush.TextBody}"
                           FontFamily="Segoe UI"
                           FontSize="11.5" />
            </DockPanel>

            <ListBox x:Name="Thumbs"
                     Background="Transparent"
                     BorderThickness="0"
                     FocusVisualStyle="{x:Null}"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     SelectionChanged="Thumbs_SelectionChanged"
                     MouseDoubleClick="Thumbs_MouseDoubleClick"
                     PreviewMouseRightButtonDown="Thumbs_RightClick"
                     KeyDown="Thumbs_KeyDown">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Margin" Value="4,2" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Chrome"
                                            CornerRadius="8"
                                            Background="{DynamicResource Brush.Subtle}"
                                            BorderBrush="{DynamicResource Brush.Border}"
                                            BorderThickness="2"
                                            Padding="5"
                                            Cursor="Hand">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="6" ShadowDepth="1"
                                                              Opacity="0.08" Color="Black"/>
                                        </Border.Effect>
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Hover}" />
                                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Accent}" />
                                            <Setter Property="TextElement.FontWeight" Value="Bold" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="160">
                            <StackPanel>
                                <Border CornerRadius="6" ClipToBounds="True" Background="{DynamicResource Brush.Subtle}">
                                    <Image Source="{Binding Thumb}"
                                           Height="110"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                                <TextBlock Text="{Binding Caption}"
                                           Foreground="{DynamicResource Brush.TextMuted}"
                                           FontFamily="Segoe UI"
                                           FontSize="11"
                                           FontWeight="Medium"
                                           HorizontalAlignment="Center"
                                           Margin="0,6,0,2" />
                            </StackPanel>

                            <Button x:Name="ItemPinBtn"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,4,4,0"
                                    Focusable="False"
                                    Cursor="Hand"
                                    Click="ItemPin_Click"
                                    ToolTip="Pin to screen always on top (P)"
                                    Tag="{Binding}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="PinBg" CornerRadius="4"
                                                Background="{DynamicResource Brush.Card}"
                                                BorderBrush="{DynamicResource Brush.BorderStrong}"
                                                BorderThickness="1"
                                                Padding="4,2"
                                                Opacity="0.85">
                                            <TextBlock Text="&#x1F4CC;" FontSize="10.5"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="PinBg" Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
                                                <Setter TargetName="PinBg" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                                <Setter TargetName="PinBg" Property="Opacity" Value="1.0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="EmptyText"
                       Text="No snips yet — take one with your snip hotkey."
                       Foreground="{DynamicResource Brush.TextMuted}"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       Margin="12,18,12,12"
                       HorizontalAlignment="Center"
                       Visibility="Collapsed" />
        </StackPanel>
    </Border>
</Window>
