<Window x:Class="AdvancedSnip.OcrResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Extracted Text – Advanced Snip"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="CanResizeWithGrip"
        Width="580" Height="380"
        MinWidth="380" MinHeight="220"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Format Chip Style -->
        <Style x:Key="ChipBtn" TargetType="Button">
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Card}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextBody}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="5"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Themed Action Button Style -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Card}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextBody}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Accent Button -->
        <Style x:Key="PrimaryAccentBtn" TargetType="Button">
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Themed floating card with drop shadow and 10px resize padding -->
    <Border CornerRadius="14" Background="{DynamicResource Brush.Card}"
            BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="5" Opacity="0.55" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Header -->
                <RowDefinition Height="Auto"/> <!-- Format Chips Bar -->
                <RowDefinition Height="*"/>    <!-- Text Area -->
                <RowDefinition Height="Auto"/> <!-- Bottom Actions -->
            </Grid.RowDefinitions>

            <!-- 1. Header / Title strip -->
            <Border Grid.Row="0" Background="{DynamicResource Brush.Sidebar}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                    CornerRadius="13,13,0,0" Padding="14,10"
                    MouseLeftButtonDown="Header_MouseDown">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="OcrAgainHeaderBtn" Style="{StaticResource ActionBtn}"
                                Content="↺ New OCR" ToolTip="Close and select another region on screen (Ctrl+N / F5)"
                                Padding="8,4" FontSize="11.5"
                                Click="OcrAgain_Click"/>
                        <Button x:Name="MonoToggleBtn" Style="{StaticResource ActionBtn}"
                                Content="&lt;/&gt; Monospace" ToolTip="Toggle Monospace / Standard font"
                                Padding="8,4" FontSize="11.5"
                                Click="MonoToggle_Click"/>
                        <Button x:Name="PinBtn" Style="{DynamicResource CaptionBtn}"
                                Content="&#xE718;" ToolTip="Pin window (keep floating on top)"
                                Click="PinBtn_Click" Margin="0,0,4,0"/>
                        <Button x:Name="CloseBtn" Style="{DynamicResource CaptionCloseBtn}"
                                Content="&#xE8BB;" ToolTip="Close (Esc)"
                                Click="CloseBtn_Click"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE8C4;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{DynamicResource Brush.Accent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Extracted Text" FontWeight="SemiBold" FontSize="13.5"
                                   Foreground="{DynamicResource Brush.TextHeading}" VerticalAlignment="Center"/>
                        <Border x:Name="CountBadge" Background="{DynamicResource Brush.Subtle}"
                                CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="CountText" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.TextMuted}"/>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 2. Quick Format Chips Strip -->
            <Border Grid.Row="1" Background="{DynamicResource Brush.Subtle}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                    Padding="12,6">
                <DockPanel>
                    <Button x:Name="OpenLinkBtn" DockPanel.Dock="Right" Style="{StaticResource ChipBtn}"
                            Content="🔗 Open Link" ToolTip="Open recognized web link in default browser"
                            Foreground="{DynamicResource Brush.Accent}" BorderBrush="{DynamicResource Brush.Accent}"
                            Padding="10,3" FontSize="11.5" FontWeight="SemiBold" Visibility="Collapsed"
                            Click="OpenLink_Click"/>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Format:" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource ChipBtn}" Content="Single line"
                                ToolTip="Merge line wraps into a single continuous line (Ctrl+Shift+C)"
                                Click="FormatSingleLine_Click"/>
                        <Button Style="{StaticResource ChipBtn}" Content="No spaces"
                                ToolTip="Strip all whitespace (useful for serials, hashes, codes)"
                                Click="FormatNoSpaces_Click"/>
                        <Button Style="{StaticResource ChipBtn}" Content="UPPER"
                                ToolTip="Convert to UPPERCASE"
                                Click="FormatUpper_Click"/>
                        <Button Style="{StaticResource ChipBtn}" Content="lower"
                                ToolTip="Convert to lowercase"
                                Click="FormatLower_Click"/>
                        <Button Style="{StaticResource ChipBtn}" Content="Title"
                                ToolTip="Convert to Title Case"
                                Click="FormatTitle_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 3. Text Content Area -->
            <Border Grid.Row="2" Padding="12,10">
                <TextBox x:Name="OcrTextBox"
                         Background="{DynamicResource Brush.Background}"
                         Foreground="{DynamicResource Brush.TextBody}"
                         BorderBrush="{DynamicResource Brush.BorderInput}"
                         BorderThickness="1"
                         Padding="12,10"
                         FontSize="13.5"
                         FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         TextChanged="OcrTextBox_TextChanged"/>
            </Border>

            <!-- 4. Bottom Actions Bar -->
            <Border Grid.Row="3" Background="{DynamicResource Brush.Sidebar}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,13,13" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusNotice" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource Brush.Success}"
                                   Text="✓ Copied to clipboard" Margin="4,0,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="OcrAgainBtn" Style="{StaticResource ActionBtn}"
                                Content="↺ OCR Again" ToolTip="Close and select another region on screen (Ctrl+N / F5)"
                                Click="OcrAgain_Click"/>
                        <Button x:Name="TranslateBtn" Style="{StaticResource ActionBtn}"
                                Content="Translate" ToolTip="Translate with Google Translate"
                                Click="Translate_Click"/>
                        <Button x:Name="SearchWebBtn" Style="{StaticResource ActionBtn}"
                                Content="Search web" ToolTip="Search text on Google"
                                Click="SearchWeb_Click"/>
                        <Button x:Name="CopyBtn" Style="{StaticResource PrimaryAccentBtn}"
                                Content="Copy" ToolTip="Copy extracted text (Ctrl+C)"
                                Click="Copy_Click"/>
                        <ResizeGrip Margin="6,0,-4,-2" VerticalAlignment="Bottom"
                                    Foreground="{DynamicResource Brush.TextMuted}"
                                    Cursor="SizeNWSE" ToolTip="Drag to resize window"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
