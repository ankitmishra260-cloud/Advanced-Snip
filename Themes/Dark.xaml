<!--
    Dark theme. Same keys as Light.xaml, different values — nothing else in the app
    needs to know which one is loaded.

    Two deliberate choices worth noting:

    * The greys are warm-neutral (#15171C upward) rather than pure black. Pure black
      next to a screenshot makes the screenshot look washed out, and OLED-style black
      panels show banding in the soft shadows this UI uses.

    * The accent lightens from #3B82F6 to #5B9CF8. The same blue that reads well on a
      white card fails contrast against a dark one; lifting it keeps the ~4.5:1 ratio
      for text and makes focus rings visible.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Brush.Window"       Color="#FF15171C"/>
    <SolidColorBrush x:Key="Brush.Sidebar"      Color="#FF1B1E24"/>
    <SolidColorBrush x:Key="Brush.Card"         Color="#FF1F2229"/>
    <SolidColorBrush x:Key="Brush.Input"        Color="#FF262A32"/>
    <SolidColorBrush x:Key="Brush.Subtle"       Color="#FF23262D"/>
    <SolidColorBrush x:Key="Brush.Hover"        Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="Brush.NavActive"    Color="#FF25344A"/>

    <!-- Lines -->
    <SolidColorBrush x:Key="Brush.Border"       Color="#FF2E323B"/>
    <SolidColorBrush x:Key="Brush.BorderInput"  Color="#FF3A3F4A"/>
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#FF474D58"/>

    <!-- Type -->
    <SolidColorBrush x:Key="Brush.Text"         Color="#FFE8EBF0"/>
    <SolidColorBrush x:Key="Brush.TextHeading"  Color="#FFD4D9E1"/>
    <SolidColorBrush x:Key="Brush.TextBody"     Color="#FFB2BAC6"/>
    <SolidColorBrush x:Key="Brush.TextFaint"    Color="#FF98A1AF"/>
    <SolidColorBrush x:Key="Brush.TextMuted"    Color="#FF7C8595"/>

    <!-- Accent + status -->
    <SolidColorBrush x:Key="Brush.Accent"       Color="#FF5B9CF8"/>
    <SolidColorBrush x:Key="Brush.AccentHover"  Color="#FF7CB0FA"/>
    <SolidColorBrush x:Key="Brush.AccentSoft"   Color="#FF1E3555"/>
    <SolidColorBrush x:Key="Brush.OnAccent"     Color="#FF0E1116"/>
    <SolidColorBrush x:Key="Brush.Success"      Color="#FF4ADE80"/>
    <SolidColorBrush x:Key="Brush.Warning"      Color="#FFFBBF24"/>
    <SolidColorBrush x:Key="Brush.Danger"       Color="#FFF87171"/>

    <SolidColorBrush x:Key="Brush.CanvasBack"   Color="#FF2B2F36"/>
</ResourceDictionary>
