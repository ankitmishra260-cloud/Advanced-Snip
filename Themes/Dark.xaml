<!--
    Dark theme. Same keys as Light.xaml, different values — nothing else in the app
    needs to know which one is loaded.

    Two deliberate choices worth noting:

    * The greys are warm-neutral (#15171C upward) rather than pure black. Pure black
      next to a screenshot makes the screenshot look washed out, and OLED-style black
      panels show banding in the soft shadows this UI uses.

    * The accent lightens from #3B82F6 to #5B9CF8. The same blue that reads well on a
      white card fails contrast against a dark one; lifting it keeps the ~4.5:1 ratio
      for text and makes focus rings visible.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Brush.Window"       Color="#FF20232A" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Sidebar"      Color="#FF262A32" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Card"         Color="#FF2B2F38" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Input"        Color="#FF33383F" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Subtle"       Color="#FF2F333B" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Hover"        Color="#FF38455B" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.NavActive"    Color="#FF25344A" po:Freeze="True"/>

    <!-- The outer edge of the window itself. WindowChrome runs with
         GlassFrameThickness="0", so Windows draws no frame here and the app
         has to draw its own — without it, a dark window on a black desktop had no visible edge at all. -->
    <SolidColorBrush x:Key="Brush.WindowEdge" Color="#FF4B5464" po:Freeze="True"/>

    <!-- Lines -->
    <SolidColorBrush x:Key="Brush.Border"       Color="#FF3E4450" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.BorderInput"  Color="#FF4A515E" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#FF5B6371" po:Freeze="True"/>

    <!-- Type -->
    <SolidColorBrush x:Key="Brush.Text"         Color="#FFFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.TextHeading"  Color="#FFF0F3F8" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.TextBody"     Color="#FFD8DEE9" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.TextFaint"    Color="#FFB0BAC9" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.TextMuted"    Color="#FF93A0B5" po:Freeze="True"/>

    <!-- Accent + status -->
    <SolidColorBrush x:Key="Brush.Accent"       Color="#FF5B9CF8" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.AccentHover"  Color="#FF7CB0FA" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.AccentSoft"   Color="#FF1E3555" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.OnAccent"     Color="#FF0E1116" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Success"      Color="#FF4ADE80" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Warning"      Color="#FFFBBF24" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Danger"       Color="#FFF87171" po:Freeze="True"/>

    <SolidColorBrush x:Key="Brush.CanvasBack"   Color="#FF2B2F36" po:Freeze="True"/>
</ResourceDictionary>
