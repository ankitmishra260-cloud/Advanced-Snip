<!--
    Cyberpunk theme. Same keys as Light.xaml and Dark.xaml — nothing else in the app needs
    to know which one is loaded, and a key missing from any one of the three is a crash on
    theme switch (the build sweep checks all three match).

    ── Where the colours come from ─────────────────────────────────────────────────

    Two HUD references. The first is amber-on-near-black: panels almost at black, thin
    blue-grey structural lines, and a hot orange glow carrying every live value. The
    second is deep navy with cyan, magenta and violet neon and corner glows.

    What they share is the important part: a base far darker than a normal dark theme,
    and accents far more saturated. So the base here is near-black with a blue cast, and
    the accents are pushed to full neon.

    Roles were assigned so both references are represented *and* the status colours stay
    distinguishable, which matters more than matching either picture exactly:

      * cyan     — the accent, from the second reference. It is the brightest colour that
                   still reads as structural rather than alarming.
      * magenta  — danger. Loud is the point.
      * amber    — warning. This is the first reference's signature orange, and it lands
                   where it is also semantically right. Using orange as the *accent*
                   instead would have left nothing distinct to warn with.

    ── The base is near-black, and that is safe here ───────────────────────────────

    The dark theme was deliberately lifted off black in v2.15, because a dark window on a
    black desktop had no visible edge. That reasoning does not apply here: Brush.WindowEdge
    is full cyan, which is a harder boundary than any grey. Near-black is what these
    references look like, and the edge is what makes it affordable.

    ── On gradients, and why there are only three ──────────────────────────────────

    A LinearGradientBrush costs more to rasterize than a solid fill. On a surface painted
    once and then left alone, that cost is paid at startup and on resize and is invisible.
    On a surface that exists hundreds of times, it is not.

    So gradients are on exactly three keys, each with one instance on screen: Brush.Window,
    Brush.Sidebar, Brush.NavActive. The window and sidebar run diagonally with a third
    stop, which is what produces the second reference's corner-glow feel — a three-stop
    diagonal costs the same as a two-stop vertical, so the look is free.

    Brush.Card is deliberately NOT a gradient: every tile in the gallery uses it, which
    means hundreds at once during a scroll. Brush.Accent stays solid because it is used as
    a text Foreground, and a gradient foreground is rasterized per glyph run.

    ── What is deliberately absent ─────────────────────────────────────────────────

    No animation. The references glow, and the obvious way to chase that is a pulse — but
    a pulse is a timer that never stops, and it would keep the render thread awake for the
    whole session.

    No DropShadowEffect or BlurEffect. Real bloom would need an offscreen render pass per
    glowing element, which is the most expensive thing this file could ask for. The glow
    here is done with colour choice alone: saturated accents against a near-black field
    read as emissive without costing anything.

    Every brush is frozen (po:Freeze) — immutable, shareable, no change-notification
    plumbing, and handed straight to the render thread.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">

    <!-- Surfaces. The three gradients live here; everything else is solid. -->
    <LinearGradientBrush x:Key="Brush.Window" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Offset="0"    Color="#FF0B1220"/>
        <GradientStop Offset="0.55" Color="#FF0A0F1C"/>
        <GradientStop Offset="1"    Color="#FF120E24"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Sidebar" StartPoint="0,0" EndPoint="0.4,1" po:Freeze="True">
        <GradientStop Offset="0"    Color="#FF0D1526"/>
        <GradientStop Offset="0.6"  Color="#FF080D18"/>
        <GradientStop Offset="1"    Color="#FF0E0A1E"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.NavActive" StartPoint="0,0" EndPoint="1,0" po:Freeze="True">
        <GradientStop Offset="0"    Color="#FF06364F"/>
        <GradientStop Offset="1"    Color="#FF1B1B4C"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Brush.Card"         Color="#FF131B2E" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Input"        Color="#FF19233C" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Subtle"       Color="#FF111829" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Hover"        Color="#FF123D5A" po:Freeze="True"/>

    <!-- The outer edge of the window. WindowChrome runs with GlassFrameThickness="0", so
         Windows draws no frame and the app must draw its own. Full cyan: on a near-black
         base this is the boundary, and it is why near-black is safe here at all. -->
    <SolidColorBrush x:Key="Brush.WindowEdge"   Color="#FF00D9FF" po:Freeze="True"/>

    <!-- Lines. Both references draw structure with thin, clearly visible edges rather
         than the barely-there separators a normal dark theme uses. -->
    <SolidColorBrush x:Key="Brush.Border"       Color="#FF2C4574" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.BorderInput"  Color="#FF385394" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#FF3E5FA8" po:Freeze="True"/>

    <!-- Type -->
    <SolidColorBrush x:Key="Brush.Text"         Color="#FFFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.TextHeading"  Color="#FFF0F7FF" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.TextBody"     Color="#FFD4E4FC" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.TextFaint"    Color="#FFA8C5F0" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.TextMuted"    Color="#FF8DAFE0" po:Freeze="True"/>

    <!-- Accent + status -->
    <SolidColorBrush x:Key="Brush.Accent"       Color="#FF00D9FF" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.AccentHover"  Color="#FF5FE9FF" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.AccentSoft"   Color="#FF07344B" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.OnAccent"     Color="#FF04070F" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Success"      Color="#FF2EE6A8" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Warning"      Color="#FFFF8A3D" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Danger"       Color="#FFFF3D7F" po:Freeze="True"/>

    <!-- The editor canvas backdrop. Flat and near-neutral on purpose: it sits directly
         behind a screenshot, and a coloured gradient there would tint the reading of the
         picture the user is trying to judge. -->
    <SolidColorBrush x:Key="Brush.CanvasBack"   Color="#FF0F1524" po:Freeze="True"/>
</ResourceDictionary>
