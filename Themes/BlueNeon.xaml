<!--
    Blue Neon theme.
    Deep midnight-navy base infused with electrifying neon blue,
    sapphire glow, azure highlights, and ice-white typography.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">

    <!-- Surfaces: deep midnight sapphire-navy gradient on window and sidebar -->
    <LinearGradientBrush x:Key="Brush.Window" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Offset="0"    Color="#FF090E1A"/>
        <GradientStop Offset="0.55" Color="#FF0B1222"/>
        <GradientStop Offset="1"    Color="#FF0F1D38"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Sidebar" StartPoint="0,0" EndPoint="0.4,1" po:Freeze="True">
        <GradientStop Offset="0"    Color="#FF0D1426"/>
        <GradientStop Offset="0.6"  Color="#FF090E1C"/>
        <GradientStop Offset="1"    Color="#FF0F1A33"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.NavActive" StartPoint="0,0" EndPoint="1,0" po:Freeze="True">
        <GradientStop Offset="0"    Color="#FF055C9E"/>
        <GradientStop Offset="0.5"  Color="#FF093A6B"/>
        <GradientStop Offset="1"    Color="#FF0C1B33"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Brush.Card"         Color="#FF0E1726" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Input"        Color="#FF152136" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Subtle"       Color="#FF0B1220" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Hover"        Color="#FF163E6E" po:Freeze="True"/>

    <!-- Window edge: glowing electric neon blue border -->
    <SolidColorBrush x:Key="Brush.WindowEdge"   Color="#FF00B4FF" po:Freeze="True"/>

    <!-- Lines & structural borders -->
    <SolidColorBrush x:Key="Brush.Border"       Color="#FF1F3352" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.BorderInput"  Color="#FF2B4670" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#FF3D649E" po:Freeze="True"/>

    <!-- Typography: optimized for maximum contrast, crystal clarity, and effortless reading -->
    <SolidColorBrush x:Key="Brush.Text"         Color="#FFFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.TextHeading"  Color="#FFF0F9FF" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.TextBody"     Color="#FFE2E8F0" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.TextFaint"    Color="#FFCBD5E1" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.TextMuted"    Color="#FF94A3B8" po:Freeze="True"/>

    <!-- Accent + status: electric neon blue, cyan hover, sapphire glow, radiant emerald -->
    <SolidColorBrush x:Key="Brush.Accent"       Color="#FF00B4FF" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.AccentHover"  Color="#FF38D2FF" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.AccentSoft"   Color="#FF0A2E59" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.OnAccent"     Color="#FFFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Success"      Color="#FF00F59B" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Warning"      Color="#FFFBBF24" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Danger"       Color="#FFF43F5E" po:Freeze="True"/>

    <!-- Editor canvas backdrop: neutral deep charcoal -->
    <SolidColorBrush x:Key="Brush.CanvasBack"   Color="#FF0E1729" po:Freeze="True"/>
</ResourceDictionary>
