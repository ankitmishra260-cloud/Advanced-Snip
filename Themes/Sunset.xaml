<!--
    Sunset theme. Same keys as Light.xaml, Dark.xaml, and Cyberpunk.xaml.
    Inspired by cosmic golden-hour ember aesthetics: deep warm obsidian space,
    luminous solar amber radiance, warm bronze structural boundaries, and
    crisp warm-ivory typography.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">

    <!-- Surfaces: subtle warm diagonal gradients on window/sidebar; solid on high-frequency cards -->
    <LinearGradientBrush x:Key="Brush.Window" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Offset="0"    Color="#FF16110D"/>
        <GradientStop Offset="0.55" Color="#FF100C09"/>
        <GradientStop Offset="1"    Color="#FF1B130E"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Sidebar" StartPoint="0,0" EndPoint="0.4,1" po:Freeze="True">
        <GradientStop Offset="0"    Color="#FF1B140F"/>
        <GradientStop Offset="0.6"  Color="#FF130E0A"/>
        <GradientStop Offset="1"    Color="#FF1A120D"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.NavActive" StartPoint="0,0" EndPoint="1,0" po:Freeze="True">
        <GradientStop Offset="0"    Color="#FF4A2A0C"/>
        <GradientStop Offset="1"    Color="#FF2E1705"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Brush.Card"         Color="#FF1E1611" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Input"        Color="#FF261C16" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Subtle"       Color="#FF17110C" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Hover"        Color="#FF422912" po:Freeze="True"/>

    <!-- Window edge: glowing warm amber boundary -->
    <SolidColorBrush x:Key="Brush.WindowEdge"   Color="#FFF59E0B" po:Freeze="True"/>

    <!-- Lines & structural borders -->
    <SolidColorBrush x:Key="Brush.Border"       Color="#FF3D2C20" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.BorderInput"  Color="#FF4F3929" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#FF735339" po:Freeze="True"/>

    <!-- Typography: warm ivory / cream for highest contrast, clarity, and comfort -->
    <SolidColorBrush x:Key="Brush.Text"         Color="#FFFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.TextHeading"  Color="#FFFFF4E6" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.TextBody"     Color="#FFEAE0D5" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.TextFaint"    Color="#FFC4B4A4" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.TextMuted"    Color="#FFA69382" po:Freeze="True"/>

    <!-- Accent + status: glowing solar amber & ember warmth -->
    <SolidColorBrush x:Key="Brush.Accent"       Color="#FFF59E0B" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.AccentHover"  Color="#FFFBBC04" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.AccentSoft"   Color="#FF422409" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.OnAccent"     Color="#FF120800" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Success"      Color="#FF34D399" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Warning"      Color="#FFF97316" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Danger"       Color="#FFF43F5E" po:Freeze="True"/>

    <!-- Editor canvas backdrop: neutral warm charcoal -->
    <SolidColorBrush x:Key="Brush.CanvasBack"   Color="#FF19130E" po:Freeze="True"/>
</ResourceDictionary>
