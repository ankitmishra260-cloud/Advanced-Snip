<!--
    Neon Dark theme.
    Deep midnight-indigo dark base infused with electrifying neon violet,
    fuchsia, electric cyan, and neon emerald highlights.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">

    <!-- Surfaces: deep midnight violet-indigo gradient on window and sidebar -->
    <LinearGradientBrush x:Key="Brush.Window" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Offset="0"    Color="#FF0D111A"/>
        <GradientStop Offset="0.55" Color="#FF101422"/>
        <GradientStop Offset="1"    Color="#FF181329"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Sidebar" StartPoint="0,0" EndPoint="0.4,1" po:Freeze="True">
        <GradientStop Offset="0"    Color="#FF111524"/>
        <GradientStop Offset="0.6"  Color="#FF0D101C"/>
        <GradientStop Offset="1"    Color="#FF161226"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.NavActive" StartPoint="0,0" EndPoint="1,0" po:Freeze="True">
        <GradientStop Offset="0"    Color="#FF381859"/>
        <GradientStop Offset="1"    Color="#FF1C1A4A"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Brush.Card"         Color="#FF171B2B" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Input"        Color="#FF1E2338" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Subtle"       Color="#FF131724" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Hover"        Color="#FF342252" po:Freeze="True"/>

    <!-- Window edge: glowing electric neon violet border -->
    <SolidColorBrush x:Key="Brush.WindowEdge"   Color="#FFA855F7" po:Freeze="True"/>

    <!-- Lines & structural borders -->
    <SolidColorBrush x:Key="Brush.Border"       Color="#FF2F3754" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.BorderInput"  Color="#FF3E4A70" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#FF5A6B9C" po:Freeze="True"/>

    <!-- Typography: cool luminescent near-white & crisp lavender for maximum contrast -->
    <SolidColorBrush x:Key="Brush.Text"         Color="#FFFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.TextHeading"  Color="#FFF1F5F9" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.TextBody"     Color="#FFE2E8F0" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.TextFaint"    Color="#FFCBD5E1" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.TextMuted"    Color="#FF94A3B8" po:Freeze="True"/>

    <!-- Accent + status: electric neon violet, neon magenta, glowing neon cyan, vibrant emerald -->
    <SolidColorBrush x:Key="Brush.Accent"       Color="#FFB855FF" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.AccentHover"  Color="#FFC875FF" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.AccentSoft"   Color="#FF38125E" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.OnAccent"     Color="#FFFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Success"      Color="#FF00F59B" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Warning"      Color="#FFFBBF24" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Danger"       Color="#FFF43F5E" po:Freeze="True"/>

    <!-- Editor canvas backdrop: neutral deep charcoal -->
    <SolidColorBrush x:Key="Brush.CanvasBack"   Color="#FF141724" po:Freeze="True"/>
</ResourceDictionary>
