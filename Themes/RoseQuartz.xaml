<!--
    Rose Quartz (Blush & Gold) Theme.
    Ethereal pearl-blush light base infused with radiant rose-gold gradients,
    electric berry accents, and ultra-high-contrast deep plum typography.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">

    <!-- Surfaces: luminous pearl-blush gradients with rose-gold undertone -->
    <LinearGradientBrush x:Key="Brush.Window" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Offset="0"    Color="#FFFDF2F4"/>
        <GradientStop Offset="0.55" Color="#FFFCE7EB"/>
        <GradientStop Offset="1"    Color="#FFFBF0F6"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Sidebar" StartPoint="0,0" EndPoint="0.4,1" po:Freeze="True">
        <GradientStop Offset="0"    Color="#FFFFF6F8"/>
        <GradientStop Offset="0.6"  Color="#FFFCECEF"/>
        <GradientStop Offset="1"    Color="#FFFDF3F7"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.NavActive" StartPoint="0,0" EndPoint="1,0" po:Freeze="True">
        <GradientStop Offset="0"    Color="#FFFECDD3"/>
        <GradientStop Offset="0.5"  Color="#FFFFE4E6"/>
        <GradientStop Offset="1"    Color="#FFFFF5F7"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Brush.Card"         Color="#FFFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Input"        Color="#FFFFF7F9" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Subtle"       Color="#FFFBEBF0" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Hover"        Color="#20E11D48" po:Freeze="True"/>

    <!-- Window edge: glowing rose-gold/berry border -->
    <SolidColorBrush x:Key="Brush.WindowEdge"   Color="#FFE11D48" po:Freeze="True"/>

    <!-- Lines & structural borders -->
    <SolidColorBrush x:Key="Brush.Border"       Color="#FFF5D0DA" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.BorderInput"  Color="#FFE8B5C4" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#FFFDA4AF" po:Freeze="True"/>

    <!-- Typography: deep plum & berry slate for maximum AAA contrast on light cards -->
    <SolidColorBrush x:Key="Brush.Text"         Color="#FF3B0716" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.TextHeading"  Color="#FF4C0519" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.TextBody"     Color="#FF5E172B" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.TextFaint"    Color="#FF883950" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.TextMuted"    Color="#FF9F4D67" po:Freeze="True"/>

    <!-- Accent + status: radiant rose berry, bright coral hover, emerald success -->
    <SolidColorBrush x:Key="Brush.Accent"       Color="#FFE11D48" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.AccentHover"  Color="#FFBE123C" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.AccentSoft"   Color="#FFFECDD3" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.OnAccent"     Color="#FFFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Success"      Color="#FF059669" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Warning"      Color="#FFD97706" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Danger"       Color="#FFE11D48" po:Freeze="True"/>

    <!-- Editor canvas backdrop -->
    <SolidColorBrush x:Key="Brush.CanvasBack"   Color="#FF9E878E" po:Freeze="True"/>
</ResourceDictionary>
