<!--
    Light theme.

    Every colour the settings/gallery/editor windows use is named here rather than
    written inline, so a theme swap is a dictionary swap. The keys are semantic
    ("what is this for") not descriptive ("what colour is it") — that's what lets the
    dark dictionary invert lightness without renaming anything.

    The capture overlays and the clipboard HUD deliberately do NOT consume these:
    they sit on top of a screenshot and need fixed dark chrome whatever the theme.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Brush.Window"       Color="#FFE7EAF0" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Sidebar"      Color="#FFF6F8FB" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Card"         Color="#FFFBFCFE" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Input"        Color="#FFFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Subtle"       Color="#FFEDF1F6" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Hover"        Color="#16000000" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.NavActive"    Color="#FFE8EEFA" po:Freeze="True"/>

    <!-- The outer edge of the window itself. WindowChrome runs with
         GlassFrameThickness="0", so Windows draws no frame here and the app
         has to draw its own — without it, a light window on a light desktop had no visible edge at all. -->
    <SolidColorBrush x:Key="Brush.WindowEdge" Color="#FFB4BECD" po:Freeze="True"/>

    <!-- Lines -->
    <SolidColorBrush x:Key="Brush.Border"       Color="#FFD3DAE4" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.BorderInput"  Color="#FFC2CBD8" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#FFA9B4C4" po:Freeze="True"/>

    <!-- Type -->
    <SolidColorBrush x:Key="Brush.Text"         Color="#FF0F172A" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.TextHeading"  Color="#FF1E293B" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.TextBody"     Color="#FF334155" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.TextFaint"    Color="#FF475569" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.TextMuted"    Color="#FF5A677B" po:Freeze="True"/>

    <!-- Accent + status -->
    <SolidColorBrush x:Key="Brush.Accent"       Color="#FF3B82F6" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.AccentHover"  Color="#FF2563EB" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.AccentSoft"   Color="#FFBFDBFE" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.OnAccent"     Color="#FFFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Success"      Color="#FF16A34A" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Warning"      Color="#FFD97706" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Danger"       Color="#FFDC2626" po:Freeze="True"/>

    <!-- The editor's canvas surround: deliberately mid-grey in both themes so a
         screenshot with white or black edges still reads as an image, not as chrome. -->
    <SolidColorBrush x:Key="Brush.CanvasBack"   Color="#FF8A9099" po:Freeze="True"/>
</ResourceDictionary>
