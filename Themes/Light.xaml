<!--
    Light theme.

    Every colour the settings/gallery/editor windows use is named here rather than
    written inline, so a theme swap is a dictionary swap. The keys are semantic
    ("what is this for") not descriptive ("what colour is it") — that's what lets the
    dark dictionary invert lightness without renaming anything.

    The capture overlays and the clipboard HUD deliberately do NOT consume these:
    they sit on top of a screenshot and need fixed dark chrome whatever the theme.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Brush.Window"       Color="#FFF0F2F5"/>
    <SolidColorBrush x:Key="Brush.Sidebar"      Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Brush.Card"         Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Brush.Input"        Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Brush.Subtle"       Color="#FFF1F5F9"/>
    <SolidColorBrush x:Key="Brush.Hover"        Color="#16000000"/>
    <SolidColorBrush x:Key="Brush.NavActive"    Color="#FFE8EEFA"/>

    <!-- Lines -->
    <SolidColorBrush x:Key="Brush.Border"       Color="#FFE2E8F0"/>
    <SolidColorBrush x:Key="Brush.BorderInput"  Color="#FFD0D7E2"/>
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#FFCBD5E1"/>

    <!-- Type -->
    <SolidColorBrush x:Key="Brush.Text"         Color="#FF1E293B"/>
    <SolidColorBrush x:Key="Brush.TextHeading"  Color="#FF334155"/>
    <SolidColorBrush x:Key="Brush.TextBody"     Color="#FF475569"/>
    <SolidColorBrush x:Key="Brush.TextFaint"    Color="#FF64748B"/>
    <SolidColorBrush x:Key="Brush.TextMuted"    Color="#FF94A3B8"/>

    <!-- Accent + status -->
    <SolidColorBrush x:Key="Brush.Accent"       Color="#FF3B82F6"/>
    <SolidColorBrush x:Key="Brush.AccentHover"  Color="#FF2563EB"/>
    <SolidColorBrush x:Key="Brush.AccentSoft"   Color="#FFBFDBFE"/>
    <SolidColorBrush x:Key="Brush.OnAccent"     Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Brush.Success"      Color="#FF16A34A"/>
    <SolidColorBrush x:Key="Brush.Warning"      Color="#FFD97706"/>
    <SolidColorBrush x:Key="Brush.Danger"       Color="#FFDC2626"/>

    <!-- The editor's canvas surround: deliberately mid-grey in both themes so a
         screenshot with white or black edges still reads as an image, not as chrome. -->
    <SolidColorBrush x:Key="Brush.CanvasBack"   Color="#FF8A9099"/>
</ResourceDictionary>
