<!--
    Midnight Amethyst (Royal Violet & Cobalt) Theme.
    Deep royal purple night infused with radiant amethyst glow and electric cobalt accents.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">

    <!-- Surfaces: Radial spotlight ambient royal amethyst diffusion on velvet obsidian -->
    <RadialGradientBrush x:Key="Brush.Window" Center="0.15,0.0" GradientOrigin="0.15,0.0" RadiusX="1.3" RadiusY="1.4" po:Freeze="True">
        <GradientStop Offset="0.00" Color="#FF231038"/>
        <GradientStop Offset="0.28" Color="#FF170B26"/>
        <GradientStop Offset="0.60" Color="#FF0F071A"/>
        <GradientStop Offset="1.00" Color="#FF08030E"/>
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="Brush.Sidebar" Center="0.5,0.0" GradientOrigin="0.5,0.0" RadiusX="1.4" RadiusY="1.1" po:Freeze="True">
        <GradientStop Offset="0.00" Color="#FF1E0D30"/>
        <GradientStop Offset="0.45" Color="#FF140822"/>
        <GradientStop Offset="1.00" Color="#FF0A0412"/>
    </RadialGradientBrush>

    <!-- Active Navigation Pill: 5-stop radiant amethyst to electric cobalt beam -->
    <LinearGradientBrush x:Key="Brush.NavActive" StartPoint="0,0" EndPoint="1,0" po:Freeze="True">
        <GradientStop Offset="0.00" Color="#FFA855F7"/>
        <GradientStop Offset="0.22" Color="#FF7C3AED"/>
        <GradientStop Offset="0.55" Color="#FF2563EB"/>
        <GradientStop Offset="0.85" Color="#FF1E0838"/>
        <GradientStop Offset="1.00" Color="#001E0838"/>
    </LinearGradientBrush>

    <!-- Cards: Specular top-lit obsidian amethyst tiles -->
    <LinearGradientBrush x:Key="Brush.Card" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0.00" Color="#FF1C0E2D"/>
        <GradientStop Offset="0.08" Color="#FF150A22"/>
        <GradientStop Offset="0.90" Color="#FF0D0616"/>
        <GradientStop Offset="1.00" Color="#FF08030E"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Input" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0.0" Color="#FF201033"/>
        <GradientStop Offset="1.0" Color="#FF130A20"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Brush.Subtle" Color="#FF0C0514" po:Freeze="True"/>

    <!-- Hover: Radial bioluminescent amethyst aura glow -->
    <RadialGradientBrush x:Key="Brush.Hover" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.75" RadiusY="0.75" po:Freeze="True">
        <GradientStop Offset="0.00" Color="#66A855F7"/>
        <GradientStop Offset="0.70" Color="#4D7C3AED"/>
        <GradientStop Offset="1.00" Color="#262563EB"/>
    </RadialGradientBrush>

    <!-- Window Edge: Glowing amethyst to cobalt gradient border -->
    <LinearGradientBrush x:Key="Brush.WindowEdge" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Offset="0.00" Color="#FFC084FC"/>
        <GradientStop Offset="0.50" Color="#FFA855F7"/>
        <GradientStop Offset="1.00" Color="#FF3B82F6"/>
    </LinearGradientBrush>

    <!-- Lines & structural borders -->
    <SolidColorBrush x:Key="Brush.Border"       Color="#FF341852" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.BorderInput"  Color="#FF472170" po:Freeze="True"/>

    <LinearGradientBrush x:Key="Brush.BorderStrong" StartPoint="0,0" EndPoint="1,0.8" po:Freeze="True">
        <GradientStop Offset="0.00" Color="#FFC084FC"/>
        <GradientStop Offset="0.50" Color="#FFA855F7"/>
        <GradientStop Offset="1.00" Color="#FF2563EB"/>
    </LinearGradientBrush>

    <!-- Typography: pure diamond white & radiant lavender -->
    <SolidColorBrush x:Key="Brush.Text"         Color="#FFFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.TextHeading"  Color="#FFFAF5FF" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.TextBody"     Color="#FFF3E8FF" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.TextFaint"    Color="#FFD8B4FE" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.TextMuted"    Color="#FFB886F8" po:Freeze="True"/>

    <!-- Accent + status: luminous amethyst violet, cobalt hover, emerald success -->
    <SolidColorBrush x:Key="Brush.Accent"       Color="#FFA855F7" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.AccentHover"  Color="#FFC084FC" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.AccentSoft"   Color="#FF38115C" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.OnAccent"     Color="#FFFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Success"      Color="#FF00F59B" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Warning"      Color="#FFFBBF24" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Danger"       Color="#FFF43F5E" po:Freeze="True"/>

    <!-- Editor canvas backdrop -->
    <SolidColorBrush x:Key="Brush.CanvasBack"   Color="#FF0C0514" po:Freeze="True"/>
</ResourceDictionary>
