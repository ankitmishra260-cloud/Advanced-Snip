<Window x:Class="AdvancedSnip.VideoReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recording"
        Icon="ASico.ico"
        Width="1060" Height="740" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window}"
        FontFamily="Segoe UI"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Padding"      Value="12,6"/>
            <Setter Property="Background"   Value="{DynamicResource Brush.Card}"/>
            <Setter Property="Foreground"   Value="{DynamicResource Brush.TextBody}"/>
            <Setter Property="BorderBrush"  Value="{DynamicResource Brush.BorderInput}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="Margin"       Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource Brush.Hover}"/>
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{DynamicResource Brush.Accent}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource Brush.Text}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Padding"         Value="18,7"/>
            <Setter Property="Background"      Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Foreground"      Value="{DynamicResource Brush.OnAccent}"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Margin"          Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource Brush.AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Danger" TargetType="Button">
            <Setter Property="Padding"         Value="12,6"/>
            <Setter Property="Background"      Value="{DynamicResource Brush.Card}"/>
            <Setter Property="Foreground"      Value="{DynamicResource Brush.Danger}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource Brush.BorderInput}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Margin"          Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource Brush.Hover}"/>
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{DynamicResource Brush.Danger}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact button for the dense editing row. -->
        <Style x:Key="Tool" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>

        <!-- Scrub bar. Themes/Controls.xaml does not template Slider, so like the PDF
             dialog's zoom slider this one carries its own. -->
        <Style x:Key="Scrub" TargetType="Slider">
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="24" Background="Transparent">
                            <Border Height="5" CornerRadius="3" VerticalAlignment="Center"
                                    Background="{DynamicResource Brush.BorderStrong}"/>
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="15" Height="15"
                                                         Fill="{DynamicResource Brush.Accent}"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="8" Background="#FF101317" ClipToBounds="True">
            <Grid>
                <MediaElement x:Name="Player"
                              LoadedBehavior="Manual" UnloadedBehavior="Manual"
                              ScrubbingEnabled="True" Stretch="Uniform"
                              MediaOpened="Player_Opened" MediaEnded="Player_Ended"
                              MediaFailed="Player_Failed"
                              MouseLeftButtonUp="Player_Click"/>

                <TextBlock x:Name="PlayerMessage" Foreground="#FFCBD5E1" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"
                           Visibility="Collapsed"/>

                <!-- Says which piece is playing and at what speed, so a project with a
                     dozen cuts is still legible while it plays. -->
                <Border x:Name="SegmentChip" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="12" CornerRadius="6" Background="#B3000000"
                        Padding="10,5" Visibility="Collapsed">
                    <TextBlock x:Name="SegmentChipText" Foreground="#FFE5E7EB" FontSize="11.5"/>
                </Border>
            </Grid>
        </Border>

        <!-- The timeline: the edit as it will be, drawn to scale. Clicking anywhere on it
             moves the playhead; each block is a kept piece and can be selected. -->
        <Border Grid.Row="1" Margin="0,12,0,0" CornerRadius="6"
                Background="{DynamicResource Brush.Subtle}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                Padding="6">
            <Grid>
                <Canvas x:Name="Timeline" Height="54" Background="Transparent"
                        MouseLeftButtonDown="Timeline_MouseDown"
                        MouseMove="Timeline_MouseMove"
                        MouseLeftButtonUp="Timeline_MouseUp"
                        SizeChanged="Timeline_SizeChanged"
                        Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- scrubber -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="PositionText" Grid.Column="0" Text="0:00"
                       VerticalAlignment="Center" FontSize="12" MinWidth="44"
                       Foreground="{DynamicResource Brush.TextBody}"/>

            <Slider x:Name="Scrubber" Grid.Column="1" Style="{StaticResource Scrub}"
                    Margin="10,0" Maximum="1"
                    Thumb.DragStarted="Scrub_DragStarted"
                    Thumb.DragCompleted="Scrub_DragCompleted"
                    ValueChanged="Scrub_ValueChanged"/>

            <TextBlock x:Name="DurationText" Grid.Column="2" Text="0:00"
                       VerticalAlignment="Center" FontSize="12" MinWidth="44"
                       TextAlignment="Right"
                       Foreground="{DynamicResource Brush.TextMuted}"/>
        </Grid>

        <!-- transport -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="PlayBtn" Style="{StaticResource Primary}" Content="Play"
                    Click="Play_Click"/>
            <Button Style="{StaticResource Tool}" Content="&#x23EE;" Click="Home_Click"
                    ToolTip="Back to the start (Home)"/>
            <Button Style="{StaticResource Tool}" Content="&#x2212;1s" Click="Back_Click"
                    ToolTip="Back one second (←, Shift+← for five)"/>
            <Button Style="{StaticResource Tool}" Content="+1s" Click="Forward_Click"
                    ToolTip="Forward one second (→, Shift+→ for five)"/>
            <Button Style="{StaticResource Tool}" Content="&#x25C0;&#x2758;" Click="PrevCut_Click"
                    ToolTip="Jump to the previous cut (Page Up)"/>
            <Button Style="{StaticResource Tool}" Content="&#x2758;&#x25B6;" Click="NextCut_Click"
                    ToolTip="Jump to the next cut (Page Down)"/>

            <Rectangle Width="1" Margin="8,4,12,4" Fill="{DynamicResource Brush.Border}"/>

            <TextBlock Text="Preview" VerticalAlignment="Center" FontSize="12"
                       Margin="0,0,7,0" Foreground="{DynamicResource Brush.TextMuted}"/>
            <ComboBox x:Name="PreviewSpeedCombo" Width="86" VerticalAlignment="Center"
                      SelectionChanged="PreviewSpeed_Changed"
                      ToolTip="How fast to play the preview. Does not change the export.">
                <ComboBoxItem Content="0.5x" Tag="0.5"/>
                <ComboBoxItem Content="1x"   Tag="1" IsSelected="True"/>
                <ComboBoxItem Content="1.5x" Tag="1.5"/>
                <ComboBoxItem Content="2x"   Tag="2"/>
            </ComboBox>

            <Rectangle Width="1" Margin="12,4,12,4" Fill="{DynamicResource Brush.Border}"/>

            <TextBlock x:Name="RangeText" VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource Brush.TextMuted}"/>
        </StackPanel>

        <!-- editing -->
        <Border Grid.Row="4" Margin="0,12,0,0" CornerRadius="8"
                Background="{DynamicResource Brush.Card}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                Padding="12,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="SplitBtn" Style="{StaticResource Tool}" Content="Split here"
                            Click="Split_Click"
                            ToolTip="Cut the clip in two at the playhead (S)"/>
                    <Button x:Name="MarkInBtn" Style="{StaticResource Tool}" Content="Mark in"
                            Click="MarkIn_Click" ToolTip="Start of a selection (I)"/>
                    <Button x:Name="MarkOutBtn" Style="{StaticResource Tool}" Content="Mark out"
                            Click="MarkOut_Click" ToolTip="End of a selection (O)"/>
                    <Button x:Name="DeleteRangeBtn" Style="{StaticResource Tool}"
                            Content="Delete selection" Click="DeleteRange_Click"
                            ToolTip="Remove the marked range and close the gap (Delete)"/>
                    <Button x:Name="KeepRangeBtn" Style="{StaticResource Tool}"
                            Content="Keep only selection" Click="KeepRange_Click"
                            ToolTip="Throw away everything outside the marked range"/>

                    <Rectangle Width="1" Margin="8,4,12,4" Fill="{DynamicResource Brush.Border}"/>

                    <Button x:Name="UndoBtn" Style="{StaticResource Tool}" Content="Undo"
                            Click="Undo_Click" ToolTip="Ctrl+Z"/>
                    <Button x:Name="RedoBtn" Style="{StaticResource Tool}" Content="Redo"
                            Click="Redo_Click" ToolTip="Ctrl+Y"/>
                    <Button x:Name="ResetEditBtn" Style="{StaticResource Tool}" Content="Start over"
                            Click="ResetEdit_Click"
                            ToolTip="Throw away every cut and go back to the whole recording"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                    <TextBlock x:Name="SelectedText" VerticalAlignment="Center" FontSize="12"
                               MinWidth="150"
                               Foreground="{DynamicResource Brush.TextBody}"
                               Text="No clip selected"/>

                    <Button x:Name="SegLeftBtn" Style="{StaticResource Tool}" Content="&#x2190;"
                            Click="MoveLeft_Click" ToolTip="Move this clip earlier"/>
                    <Button x:Name="SegRightBtn" Style="{StaticResource Tool}" Content="&#x2192;"
                            Click="MoveRight_Click" ToolTip="Move this clip later"/>
                    <Button x:Name="SegDeleteBtn" Style="{StaticResource Tool}" Content="Remove clip"
                            Click="RemoveSegment_Click"/>

                    <Rectangle Width="1" Margin="8,4,12,4" Fill="{DynamicResource Brush.Border}"/>

                    <TextBlock Text="Speed" VerticalAlignment="Center" FontSize="12"
                               Margin="0,0,7,0" Foreground="{DynamicResource Brush.TextMuted}"/>
                    <ComboBox x:Name="SegSpeedCombo" Width="96" VerticalAlignment="Center"
                              SelectionChanged="SegSpeed_Changed"
                              ToolTip="Play this clip faster or slower in the finished file">
                        <ComboBoxItem Content="0.5x" Tag="0.5"/>
                        <ComboBoxItem Content="0.75x" Tag="0.75"/>
                        <ComboBoxItem Content="1x" Tag="1" IsSelected="True"/>
                        <ComboBoxItem Content="1.5x" Tag="1.5"/>
                        <ComboBoxItem Content="2x" Tag="2"/>
                        <ComboBoxItem Content="4x" Tag="4"/>
                    </ComboBox>

                    <CheckBox x:Name="SegMuteChk" Content="Mute this clip"
                              VerticalAlignment="Center" Margin="14,0,0,0" FontSize="12"
                              Foreground="{DynamicResource Brush.TextBody}"
                              Checked="SegMute_Changed" Unchecked="SegMute_Changed"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- file actions -->
        <Grid Grid.Row="5" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock x:Name="FileText" VerticalAlignment="Center" FontSize="12"
                           TextTrimming="CharacterEllipsis" MaxWidth="330"
                           Foreground="{DynamicResource Brush.TextMuted}"/>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12"
                           Margin="12,0,0,0"
                           Foreground="{DynamicResource Brush.Accent}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ComboBox x:Name="ExportQualityCombo" Width="150" VerticalAlignment="Center"
                          Margin="0,0,8,0"
                          ToolTip="How much detail the exported file keeps">
                    <ComboBoxItem Content="Efficient" Tag="Efficient"/>
                    <ComboBoxItem Content="Balanced" Tag="Balanced"/>
                    <ComboBoxItem Content="High quality" Tag="High" IsSelected="True"/>
                    <ComboBoxItem Content="Maximum" Tag="Maximum"/>
                </ComboBox>
                <Button Style="{StaticResource Ghost}" Content="Show in folder"
                        Click="Reveal_Click"/>
                <Button x:Name="DeleteBtn" Style="{StaticResource Danger}" Content="Delete"
                        Click="Delete_Click"
                        ToolTip="Sends the recording to the Recycle Bin"/>
                <Button x:Name="TrimBtn" Style="{StaticResource Primary}" Content="Export edit"
                        Click="Trim_Click" Margin="0"
                        ToolTip="Writes a new file next to the original. The original is never changed."/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
