<Window x:Class="AdvancedSnip.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Advanced Snip"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        Focusable="False"
        ShowActivated="False"
        FontFamily="Segoe UI"
        MouseLeftButtonUp="Toast_Click">

    <!-- Themed: follows the palette chosen in Settings, like the clipboard HUD and
         its preview. The drop shadow and border keep it readable over any desktop. -->
    <Border CornerRadius="12" Background="{DynamicResource Brush.Card}"
            BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
            Padding="18,14" MaxWidth="460">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="5" Opacity="0.55" Color="Black"/>
        </Border.Effect>

        <DockPanel>
            <Border x:Name="ThumbFrame" DockPanel.Dock="Left" Width="72" Height="72"
                    CornerRadius="6" ClipToBounds="True" Background="{DynamicResource Brush.Subtle}"
                    Margin="0,0,12,0" Visibility="Collapsed">
                <Image x:Name="ThumbImage" Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Foreground="{DynamicResource Brush.TextHeading}" FontSize="14"
                           FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="BodyText" Foreground="{DynamicResource Brush.TextBody}" FontSize="12.5"
                           Margin="0,3,0,0" TextWrapping="Wrap"
                           Visibility="Collapsed"/>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
