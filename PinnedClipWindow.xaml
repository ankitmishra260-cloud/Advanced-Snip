<Window x:Class="AdvancedSnip.PinnedClipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pinned Screenshot"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False"
        ResizeMode="CanResize"
        MinWidth="200"
        MinHeight="120"
        SizeToContent="Manual"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        PreviewMouseDoubleClick="Window_PreviewMouseDoubleClick"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseWheel="Window_PreviewMouseWheel"
        LocationChanged="Window_LocationChanged"
        SizeChanged="Window_SizeChanged"
        StateChanged="Window_StateChanged">

    <Window.Resources>
        <Style x:Key="PinnedActionButtonStyle" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="5" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UnpinButtonStyle" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Subtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="5" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE77A;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,5,0"
                                           Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                                <TextBlock Text="Unpin" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextHeading}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OverlayMiniButtonStyle" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="4" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootWindowGrid" SnapsToDevicePixels="True">
        <!-- 1. Window Outer Border & Drop Shadow (Spans entire window) -->
        <Border x:Name="WindowBorder"
                CornerRadius="12"
                BorderBrush="{DynamicResource Brush.BorderStrong}"
                BorderThickness="1.5"
                Background="Transparent"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect x:Name="WindowShadow" BlurRadius="26" ShadowDepth="4" Opacity="0.45" Color="Black"/>
            </Border.Effect>
        </Border>

        <!-- 2. Window Content Grid: Row 0 = Title/HeaderBar (Chrome), Row 1 = Image (Independent) -->
        <Grid Margin="1.5" SnapsToDevicePixels="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header Card (Normal mode, part of window chrome) -->
            <Border x:Name="HeaderCard"
                    Grid.Row="0"
                    CornerRadius="10.5,10.5,0,0"
                    Background="{DynamicResource Brush.Card}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,0,0,1"
                    Padding="8,5,8,5">
                <DockPanel x:Name="HeaderBar" LastChildFill="True">
                <!-- Left: Pin badge & Stacking indicator & info -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <Border CornerRadius="4" Background="{DynamicResource Brush.AccentSoft}"
                            BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1"
                            Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="10.5"
                                       Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Pinned" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Stacking Overlap Badge (Visible when overlapping another pin) -->
                    <Border x:Name="StackBadge" CornerRadius="4"
                            Background="{DynamicResource Brush.AccentSoft}"
                            BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1"
                            Padding="5,2" Margin="0,0,6,0" VerticalAlignment="Center"
                            Visibility="Collapsed" Cursor="Hand"
                            MouseLeftButtonDown="StackBadge_Click"
                            ToolTip="Overlapping with another pinned image · Click to bring to top">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE81E;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                       Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,3,0"/>
                            <TextBlock x:Name="StackBadgeText" Text="Stacked" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="DetailText"
                               Text="Screenshot"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Cursor="Hand"
                               ToolTip="Click to rename (F2)"
                               MouseLeftButtonDown="DetailText_Click"/>
                </StackPanel>

                <!-- Right: Action buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" DockPanel.Dock="Right">
                    <TextBlock x:Name="CopyStatusText"
                               Text=""
                               Foreground="{DynamicResource Brush.Success}"
                               FontWeight="SemiBold"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>

                    <Button x:Name="CopyBtn"
                            Style="{StaticResource PinnedActionButtonStyle}"
                            Click="Copy_Click"
                            ToolTip="Copy image to clipboard (Ctrl+C)"
                            Margin="0,0,4,0">
                        <TextBlock Text="Copy" FontSize="11" Foreground="{DynamicResource Brush.TextBody}"/>
                    </Button>

                    <!-- Desktop Pin Persistence Toggle -->
                    <Button x:Name="DesktopPinBtn"
                            Style="{StaticResource PinnedActionButtonStyle}"
                            Click="DesktopPin_Click"
                            ToolTip="Pin on Desktop (Persistent across app &amp; Windows restarts) · Click to toggle"
                            Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="DesktopIcon" Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,4,0"
                                       Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="DesktopLabel" Text="Pin to Desktop" FontSize="11" Foreground="{DynamicResource Brush.TextHeading}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Title-bar-less / Minimal Mode Toggle (Only visible when IsDesktopPinned == true) -->
                    <Button x:Name="FramelessBtn"
                            Style="{StaticResource PinnedActionButtonStyle}"
                            Click="FramelessToggle_Click"
                            ToolTip="Minimal Mode · Hide title bar for a clean desktop widget (F)"
                            Visibility="Collapsed"
                            Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="FramelessIcon" Text="&#xE740;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,4,0"
                                       Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="FramelessLabel" Text="Minimal" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Always On Top Toggle -->
                    <Button x:Name="TopmostBtn"
                            Style="{StaticResource PinnedActionButtonStyle}"
                            Click="TopmostToggle_Click"
                            ToolTip="Always on Top (Click to toggle)"
                            Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TopmostIcon" Text="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,4,0"
                                       Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TopmostLabel" Text="Topmost" FontSize="11" Foreground="{DynamicResource Brush.TextHeading}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="ZoomResetBtn"
                            Style="{StaticResource PinnedActionButtonStyle}"
                            Click="ZoomReset_Click"
                            ToolTip="Reset zoom (100%) · Scroll wheel to zoom"
                            Margin="0,0,4,0">
                        <TextBlock x:Name="ZoomText" Text="100%" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"/>
                    </Button>

                    <Button x:Name="UnpinBtn"
                            Style="{StaticResource UnpinButtonStyle}"
                            Click="Unpin_Click"
                            ToolTip="Unpin (Esc) - Keeps image safely in clipboard"/>
                </StackPanel>

                <!-- Center Drag Grip -->
                <TextBlock Text="&#x22EF;"
                           FontSize="14"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextMuted}"
                           Opacity="0.6"
                           Cursor="SizeAll"
                           ToolTip="Drag anywhere to reposition"/>
                </DockPanel>
            </Border>

            <!-- Image Viewport Area (Independent Layer, Opacity = CurrentImageOpacity) -->
            <Border x:Name="ImageBorder"
                    Grid.Row="1"
                    CornerRadius="0,0,10.5,10.5"
                    ClipToBounds="True"
                    Background="Transparent"
                    Cursor="SizeAll">
                    <Border.ContextMenu>
                        <ContextMenu x:Name="ImageContextMenu">
                            <!-- Window Modes -->
                            <MenuItem x:Name="ContextFrameless" Header="Minimal mode (Frameless)" Click="ContextFrameless_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE740;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource Brush.Accent}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="ContextDesktop" Header="Pin to Desktop" Click="ContextDesktop_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource Brush.Accent}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="ContextSlap" Header="Slap to Desktop (Behind Icons)" Click="ContextSlap_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE72D;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#FF4D4F"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="ContextTopmost" Header="Always on Top" Click="ContextTopmost_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource Brush.Accent}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>

                            <!-- Rename -->
                            <MenuItem x:Name="ContextRename" Header="Rename image... (F2)" Click="Rename_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE8AC;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource Brush.Accent}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>

                            <!-- Canvas & Scaling Options -->
                            <MenuItem x:Name="ContextCanvasHeader" Header="Canvas &amp; Sizing">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE799;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource Brush.Accent}"/>
                                </MenuItem.Icon>
                                <MenuItem x:Name="ContextFitUniform" Header="Fit to Window (Uniform)" Click="FitUniform_Click" IsChecked="True"/>
                                <MenuItem x:Name="ContextFitFillCanvas" Header="Fill Canvas (Crop to Fill)" Click="FitFillCanvas_Click"/>
                                <MenuItem x:Name="ContextFitStretch" Header="Stretch to Fill Window" Click="FitStretch_Click"/>
                                <MenuItem x:Name="ContextFitActual" Header="Actual Size (1:1 / 100%)" Click="FitActual_Click"/>
                                <Separator/>
                                <MenuItem x:Name="ContextSnapToImage" Header="Snap Window to Image Bounds" Click="SnapToImage_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE71E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource Brush.Accent}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuItem>

                            <!-- Transparency & Opacity (Combined Entry) -->
                            <MenuItem x:Name="ContextTranslucencyHeader" Header="Transparency">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource Brush.Accent}"/>
                                </MenuItem.Icon>

                                <!-- 1. Pin Window Transparency -->
                                <MenuItem x:Name="ContextWinOpacityHeader" Header="Pin Window Transparency">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource Brush.Accent}"/>
                                    </MenuItem.Icon>
                                    <MenuItem x:Name="ContextWinOpacity100" Header="100% – Fully Opaque" Click="WinOpacity100_Click" IsChecked="True"/>
                                    <MenuItem x:Name="ContextWinOpacity85"  Header="85% – Subtle Glass" Click="WinOpacity85_Click"/>
                                    <MenuItem x:Name="ContextWinOpacity70"  Header="70% – Translucent" Click="WinOpacity70_Click"/>
                                    <MenuItem x:Name="ContextWinOpacity50"  Header="50% – See-Through" Click="WinOpacity50_Click"/>
                                    <MenuItem x:Name="ContextWinOpacity30"  Header="30% – Ghost Trace" Click="WinOpacity30_Click"/>
                                </MenuItem>

                                <!-- 2. Image Transparency -->
                                <MenuItem x:Name="ContextImgOpacityHeader" Header="Image Transparency">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource Brush.Accent}"/>
                                    </MenuItem.Icon>
                                    <MenuItem x:Name="ContextImgOpacity100" Header="100% – Fully Opaque" Click="ImgOpacity100_Click" IsChecked="True"/>
                                    <MenuItem x:Name="ContextImgOpacity85"  Header="85% – Subtle Glass" Click="ImgOpacity85_Click"/>
                                    <MenuItem x:Name="ContextImgOpacity70"  Header="70% – Translucent" Click="ImgOpacity70_Click"/>
                                    <MenuItem x:Name="ContextImgOpacity50"  Header="50% – See-Through" Click="ImgOpacity50_Click"/>
                                    <MenuItem x:Name="ContextImgOpacity30"  Header="30% – Ghost Trace" Click="ImgOpacity30_Click"/>
                                </MenuItem>

                                <Separator/>
                                <MenuItem Header="Reset Both to 100%" Click="ResetAllOpacity_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuItem>

                            <!-- Rotate & Flip -->
                            <MenuItem x:Name="ContextRotateHeader" Header="Rotate &amp; Flip">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE7AD;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource Brush.Accent}"/>
                                </MenuItem.Icon>
                                <MenuItem Header="Rotate 90° Clockwise" Click="Rotate90_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE7AD;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Rotate 180°" Click="Rotate180_Click"/>
                                <Separator/>
                                <MenuItem Header="Flip Horizontal (Mirror)" Click="FlipH_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE7A9;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Flip Vertical" Click="FlipV_Click"/>
                                <Separator/>
                                <MenuItem Header="Reset Orientations" Click="ResetTransform_Click"/>
                            </MenuItem>

                            <Separator/>
                            <MenuItem Header="Copy image (Ctrl+C)" Click="Copy_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource Brush.Accent}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Reset zoom (100%)" Click="ZoomReset_Click"/>
                            <Separator/>
                            <MenuItem Header="Unpin" Click="Unpin_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource Brush.Danger}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Border.ContextMenu>

                    <ScrollViewer x:Name="ImageScrollViewer"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Disabled"
                                  Focusable="False">
                        <Grid x:Name="ImageHost" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Grid.LayoutTransform>
                                <ScaleTransform x:Name="ImageScale" ScaleX="1.0" ScaleY="1.0"/>
                            </Grid.LayoutTransform>
                            <Image x:Name="PinnedImage"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="ImageFlipScale" ScaleX="1.0" ScaleY="1.0"/>
                                        <RotateTransform x:Name="ImageRotate" Angle="0"/>
                                    </TransformGroup>
                                </Image.RenderTransform>
                            </Image>
                        </Grid>
                    </ScrollViewer>
            </Border>
        </Grid>

        <!-- Small transparent overlay on top right corner (Active in Minimal / Title-bar-less mode) -->
        <Border x:Name="FramelessOverlay"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,6,6,0"
                        CornerRadius="6"
                        Background="#D0121722"
                        BorderBrush="{DynamicResource Brush.BorderStrong}"
                        BorderThickness="1"
                        Padding="3,2"
                        Opacity="0.45"
                        Visibility="Collapsed"
                        MouseEnter="FramelessOverlay_MouseEnter"
                        MouseLeave="FramelessOverlay_MouseLeave">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.55" Color="Black"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Restore Title Bar Button -->
                        <Button Style="{StaticResource OverlayMiniButtonStyle}"
                                Click="ExitFrameless_Click"
                                ToolTip="Show Title Bar / Full Controls">
                            <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{DynamicResource Brush.Accent}"/>
                        </Button>

                        <!-- Topmost toggle -->
                        <Button x:Name="OverlayTopmostBtn"
                                Style="{StaticResource OverlayMiniButtonStyle}"
                                Click="TopmostToggle_Click"
                                ToolTip="Always on Top (Click to toggle)">
                            <TextBlock x:Name="OverlayTopmostIcon" Text="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{DynamicResource Brush.Accent}"/>
                        </Button>

                        <!-- All Options Menu Button -->
                        <Button x:Name="OverlayMenuBtn"
                                Style="{StaticResource OverlayMiniButtonStyle}"
                                Click="OverlayMenu_Click"
                                ToolTip="All Options · Desktop Pin, Zoom, Copy, Settings">
                            <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{DynamicResource Brush.TextHeading}"/>
                        </Button>

                        <!-- Copy button -->
                        <Button Style="{StaticResource OverlayMiniButtonStyle}"
                                Click="Copy_Click"
                                ToolTip="Copy image (Ctrl+C)">
                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{DynamicResource Brush.TextHeading}"/>
                        </Button>

                        <!-- Unpin button -->
                        <Button Style="{StaticResource OverlayMiniButtonStyle}"
                                Click="Unpin_Click"
                                ToolTip="Unpin (Esc)">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10.5"
                                       Foreground="{DynamicResource Brush.Danger}"/>
                        </Button>
                    </StackPanel>
        </Border>
    </Grid>
</Window>
