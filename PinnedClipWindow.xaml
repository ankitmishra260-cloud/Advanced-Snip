<Window x:Class="AdvancedSnip.PinnedClipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pinned Screenshot"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False"
        ResizeMode="CanResize"
        MinWidth="200"
        MinHeight="120"
        SizeToContent="Manual"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        PreviewMouseDoubleClick="Window_PreviewMouseDoubleClick"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseWheel="Window_PreviewMouseWheel"
        LocationChanged="Window_LocationChanged"
        SizeChanged="Window_SizeChanged"
        StateChanged="Window_StateChanged">

    <Window.Resources>
        <Style x:Key="PinnedActionButtonStyle" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="5" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UnpinButtonStyle" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Subtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="5" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE77A;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,5,0"
                                           Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                                <TextBlock Text="Unpin" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextHeading}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OverlayMiniButtonStyle" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="4" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolRadioStyle" TargetType="RadioButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root" CornerRadius="5" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextHeading}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniToolbarBtnStyle" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextHeading}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="4" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootWindowGrid" SnapsToDevicePixels="True">
        <!-- 1. Window Outer Border & Drop Shadow (Spans entire window) -->
        <Border x:Name="WindowBorder"
                CornerRadius="12"
                BorderBrush="{DynamicResource Brush.BorderStrong}"
                BorderThickness="1.5"
                Background="Transparent"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect x:Name="WindowShadow" BlurRadius="26" ShadowDepth="4" Opacity="0.45" Color="Black"/>
            </Border.Effect>
        </Border>

        <!-- 2. Window Content Grid: Row 0 = Title/HeaderBar (Chrome), Row 1 = Image (Independent) -->
        <Grid Margin="1.5" SnapsToDevicePixels="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header Card (Normal mode, part of window chrome) -->
            <Border x:Name="HeaderCard"
                    Grid.Row="0"
                    CornerRadius="10.5,10.5,0,0"
                    Background="{DynamicResource Brush.Card}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,0,0,1"
                    Padding="8,5,8,5">
                <DockPanel x:Name="HeaderBar" LastChildFill="True">
                <!-- Left: Unpin action & Stacking indicator & info -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <!-- Unpin button on Top Left (Replaces 'Pinned' badge) -->
                    <Button x:Name="UnpinBtn"
                            Style="{StaticResource UnpinButtonStyle}"
                            Click="Unpin_Click"
                            ToolTip="Unpin (Esc) · Keeps image safely in clipboard"
                            Margin="0,0,6,0"/>

                    <!-- Stacking Overlap Badge (Visible when overlapping another pin) -->
                    <Border x:Name="StackBadge" CornerRadius="4"
                            Background="{DynamicResource Brush.AccentSoft}"
                            BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1"
                            Padding="5,2" Margin="0,0,6,0" VerticalAlignment="Center"
                            Visibility="Collapsed" Cursor="Hand"
                            MouseLeftButtonDown="StackBadge_Click"
                            ToolTip="Overlapping with another pinned image · Click to bring to top">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE81E;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                       Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,3,0"/>
                            <TextBlock x:Name="StackBadgeText" Text="Stacked" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="DetailText"
                               Text="Screenshot"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               FontSize="11"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right: Action buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" DockPanel.Dock="Right">
                    <TextBlock x:Name="CopyStatusText"
                               Text=""
                               Foreground="{DynamicResource Brush.Success}"
                               FontWeight="SemiBold"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>

                    <!-- Annotate Mode Toggle (Normal Mode Only) -->
                    <Button x:Name="AnnotateBtn"
                            Style="{StaticResource PinnedActionButtonStyle}"
                            Click="AnnotateToggle_Click"
                            ToolTip="Annotate &amp; Links · Draw arrow, circle, text, or add clickable links (Ctrl+E)"
                            Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="AnnotateIcon" Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,4,0"
                                       Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="AnnotateLabel" Text="Annotate" FontSize="11" Foreground="{DynamicResource Brush.TextHeading}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="CopyBtn"
                            Style="{StaticResource PinnedActionButtonStyle}"
                            Click="Copy_Click"
                            ToolTip="Copy image to clipboard (Ctrl+C)"
                            Margin="0,0,4,0">
                        <TextBlock Text="Copy" FontSize="11" Foreground="{DynamicResource Brush.TextBody}"/>
                    </Button>

                    <!-- Desktop Pin Persistence Toggle -->
                    <Button x:Name="DesktopPinBtn"
                            Style="{StaticResource PinnedActionButtonStyle}"
                            Click="DesktopPin_Click"
                            ToolTip="Pin on Desktop (Persistent across app &amp; Windows restarts) · Click to toggle"
                            Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="DesktopIcon" Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,4,0"
                                       Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="DesktopLabel" Text="Pin to Desktop" FontSize="11" Foreground="{DynamicResource Brush.TextHeading}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Title-bar-less / Minimal Mode Toggle (Only visible when IsDesktopPinned == true) -->
                    <Button x:Name="FramelessBtn"
                            Style="{StaticResource PinnedActionButtonStyle}"
                            Click="FramelessToggle_Click"
                            ToolTip="Minimal Mode · Hide title bar for a clean desktop widget (F)"
                            Visibility="Collapsed"
                            Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="FramelessIcon" Text="&#xE740;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,4,0"
                                       Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="FramelessLabel" Text="Minimal" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Always On Top Toggle -->
                    <Button x:Name="TopmostBtn"
                            Style="{StaticResource PinnedActionButtonStyle}"
                            Click="TopmostToggle_Click"
                            ToolTip="Always on Top (Click to toggle)"
                            Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TopmostIcon" Text="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,4,0"
                                       Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TopmostLabel" Text="Topmost" FontSize="11" Foreground="{DynamicResource Brush.TextHeading}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Zoom reset (only visible if zoomed) -->
                    <Button x:Name="ZoomResetBtn"
                            Style="{StaticResource PinnedActionButtonStyle}"
                            Click="ZoomReset_Click"
                            ToolTip="Reset zoom (100%) · Scroll wheel to zoom"
                            Visibility="Collapsed"
                            Margin="0,0,4,0">
                        <TextBlock x:Name="ZoomText" Text="100%" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"/>
                    </Button>

                    <!-- Vertical Three Dots Menu Button (far right, opens same context menu as right-click) -->
                    <Button x:Name="VerticalMenuBtn"
                            Style="{StaticResource PinnedActionButtonStyle}"
                            Click="VerticalMenuBtn_Click"
                            ToolTip="More options · OCR, Canvas, Transparency, Rotate"
                            Padding="6,3"
                            Margin="2,0,0,0">
                        <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="{DynamicResource Brush.TextHeading}" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
                </DockPanel>
            </Border>

            <!-- Image Viewport Area (Independent Layer, Opacity = CurrentImageOpacity) -->
            <Border x:Name="ImageBorder"
                    Grid.Row="1"
                    CornerRadius="0,0,10.5,10.5"
                    ClipToBounds="True"
                    Background="Transparent"
                    Cursor="SizeAll">
                    <Border.ContextMenu>
                        <ContextMenu x:Name="ImageContextMenu">
                            <!-- Annotations & Hyperlinks (Normal Mode Only) -->
                            <MenuItem x:Name="ContextAnnotateHeader" Header="Annotate &amp; Links">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource Brush.Accent}"/>
                                </MenuItem.Icon>
                                <MenuItem Header="Annotation Toolbar (Ctrl+E)" Click="ContextAnnotateToolbar_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Draw Arrow (A)" Click="ContextDrawArrow_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xEDBE;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Draw Circle (C)" Click="ContextDrawCircle_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xEA3B;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Add Text Annotation (T)" Click="ContextAddText_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE8D2;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Add Hyperlink Button... (L)" Click="ContextAddLink_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#FF00D2FF"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Clear All Annotations" Click="ContextClearAnnotations_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource Brush.Danger}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuItem>
                            <Separator/>

                            <!-- 1. Text & OCR Recognition -->
                            <MenuItem x:Name="ContextSelectTextOcr" Header="Select Text (OCR)..." Click="ContextSelectTextOcr_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE8C1;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource Brush.Accent}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="ContextCopyAllOcr" Header="Copy All Text (OCR)" Click="ContextCopyAllOcr_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource Brush.Accent}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>

                            <!-- 2. Window Modes & Placement -->
                            <MenuItem x:Name="ContextTopmost" Header="Always on Top" Click="ContextTopmost_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource Brush.Accent}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="ContextFrameless" Header="Minimal Mode (Frameless)" Click="ContextFrameless_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE740;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource Brush.Accent}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="ContextDesktop" Header="Pin to Desktop" Click="ContextDesktop_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource Brush.Accent}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="ContextSlap" Header="Slap to Desktop" Click="ContextSlap_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE72D;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#FF4D4F"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>

                            <!-- 3. Canvas & Transformations -->
                            <MenuItem x:Name="ContextCanvasHeader" Header="Canvas &amp; Sizing">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE799;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource Brush.Accent}"/>
                                </MenuItem.Icon>
                                <MenuItem x:Name="ContextFitUniform" Header="Fit to Window (Uniform)" Click="FitUniform_Click" IsChecked="True"/>
                                <MenuItem x:Name="ContextFitFillCanvas" Header="Fill Canvas (Crop to Fill)" Click="FitFillCanvas_Click"/>
                                <MenuItem x:Name="ContextFitStretch" Header="Stretch to Fill Window" Click="FitStretch_Click"/>
                                <MenuItem x:Name="ContextFitActual" Header="Actual Size (1:1 / 100%)" Click="FitActual_Click"/>
                                <Separator/>
                                <MenuItem x:Name="ContextSnapToImage" Header="Snap Window to Image Bounds" Click="SnapToImage_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE71E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource Brush.Accent}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuItem>

                            <!-- Transparency & Opacity -->
                            <MenuItem x:Name="ContextTranslucencyHeader" Header="Transparency">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource Brush.Accent}"/>
                                </MenuItem.Icon>

                                <!-- Window Transparency -->
                                <MenuItem x:Name="ContextWinOpacityHeader" Header="Pin Window Transparency">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource Brush.Accent}"/>
                                    </MenuItem.Icon>
                                    <MenuItem x:Name="ContextWinOpacity100" Header="100% – Fully Opaque" Click="WinOpacity100_Click" IsChecked="True"/>
                                    <MenuItem x:Name="ContextWinOpacity85"  Header="85% – Subtle Glass" Click="WinOpacity85_Click"/>
                                    <MenuItem x:Name="ContextWinOpacity70"  Header="70% – Translucent" Click="WinOpacity70_Click"/>
                                    <MenuItem x:Name="ContextWinOpacity50"  Header="50% – See-Through" Click="WinOpacity50_Click"/>
                                    <MenuItem x:Name="ContextWinOpacity30"  Header="30% – Ghost Trace" Click="WinOpacity30_Click"/>
                                </MenuItem>

                                <!-- Image Transparency -->
                                <MenuItem x:Name="ContextImgOpacityHeader" Header="Image Transparency">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource Brush.Accent}"/>
                                    </MenuItem.Icon>
                                    <MenuItem x:Name="ContextImgOpacity100" Header="100% – Fully Opaque" Click="ImgOpacity100_Click" IsChecked="True"/>
                                    <MenuItem x:Name="ContextImgOpacity85"  Header="85% – Subtle Glass" Click="ImgOpacity85_Click"/>
                                    <MenuItem x:Name="ContextImgOpacity70"  Header="70% – Translucent" Click="ImgOpacity70_Click"/>
                                    <MenuItem x:Name="ContextImgOpacity50"  Header="50% – See-Through" Click="ImgOpacity50_Click"/>
                                    <MenuItem x:Name="ContextImgOpacity30"  Header="30% – Ghost Trace" Click="ImgOpacity30_Click"/>
                                </MenuItem>

                                <Separator/>
                                <MenuItem Header="Reset Both to 100%" Click="ResetAllOpacity_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuItem>

                            <!-- Rotate & Flip -->
                            <MenuItem x:Name="ContextRotateHeader" Header="Rotate &amp; Flip">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE7AD;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource Brush.Accent}"/>
                                </MenuItem.Icon>
                                <MenuItem Header="Rotate 90° Clockwise" Click="Rotate90_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE7AD;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Rotate 180°" Click="Rotate180_Click"/>
                                <Separator/>
                                <MenuItem Header="Flip Horizontal (Mirror)" Click="FlipH_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE7A9;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Flip Vertical" Click="FlipV_Click"/>
                                <Separator/>
                                <MenuItem Header="Reset Orientations" Click="ResetTransform_Click"/>
                            </MenuItem>

                            <Separator/>

                            <!-- 4. Operations & File -->
                            <MenuItem Header="Copy Image (Ctrl+C)" Click="Copy_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource Brush.Accent}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Save Image As... (Ctrl+S)" Click="SaveAs_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource Brush.Accent}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="ContextRename" Header="Rename Image... (F2)" Click="Rename_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE8AC;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource Brush.Accent}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Reset Zoom (100%)" Click="ZoomReset_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE71E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource Brush.Accent}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>

                            <!-- 5. Dismiss -->
                            <MenuItem Header="Unpin" Click="Unpin_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource Brush.Danger}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Border.ContextMenu>

                    <Grid x:Name="ImageViewportGrid">
                        <ScrollViewer x:Name="ImageScrollViewer"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Disabled"
                                      Focusable="False">
                            <Grid x:Name="ImageHost" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Grid.LayoutTransform>
                                    <ScaleTransform x:Name="ImageScale" ScaleX="1.0" ScaleY="1.0"/>
                                </Grid.LayoutTransform>
                                <Image x:Name="PinnedImage"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       RenderTransformOrigin="0.5,0.5">
                                    <Image.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="ImageFlipScale" ScaleX="1.0" ScaleY="1.0"/>
                                            <RotateTransform x:Name="ImageRotate" Angle="0"/>
                                        </TransformGroup>
                                    </Image.RenderTransform>
                                </Image>

                                <!-- Canvas rendering persistent shape annotations (Arrow, Circle, Text) -->
                                <Canvas x:Name="AnnotationCanvas"
                                        Background="Transparent"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        IsHitTestVisible="False"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Canvas.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="AnnotationFlipScale" ScaleX="1.0" ScaleY="1.0"/>
                                            <RotateTransform x:Name="AnnotationRotate" Angle="0"/>
                                        </TransformGroup>
                                    </Canvas.RenderTransform>
                                </Canvas>

                                <!-- Canvas hosting interactive Hyperlink buttons -->
                                <Canvas x:Name="HyperlinkCanvas"
                                        Background="Transparent"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Canvas.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="HyperlinkFlipScale" ScaleX="1.0" ScaleY="1.0"/>
                                            <RotateTransform x:Name="HyperlinkRotate" Angle="0"/>
                                        </TransformGroup>
                                    </Canvas.RenderTransform>
                                </Canvas>

                                <!-- Canvas rendering subtle detected word boxes (Active only during OCR Mode) -->
                                <Canvas x:Name="OcrTextCanvas"
                                        Background="Transparent"
                                        Visibility="Collapsed"
                                        IsHitTestVisible="False"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Canvas.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="OcrFlipScale" ScaleX="1.0" ScaleY="1.0"/>
                                            <RotateTransform x:Name="OcrRotate" Angle="0"/>
                                        </TransformGroup>
                                    </Canvas.RenderTransform>
                                </Canvas>
                            </Grid>
                        </ScrollViewer>

                        <!-- Interactive OCR Selection & Overlay Layer -->
                        <Canvas x:Name="OcrInteractionLayer"
                                Background="Transparent"
                                Visibility="Collapsed"
                                Cursor="IBeam"
                                ClipToBounds="True"
                                MouseLeftButtonDown="OcrLayer_MouseDown"
                                MouseMove="OcrLayer_MouseMove"
                                MouseLeftButtonUp="OcrLayer_MouseUp">

                            <!-- Top Helper Banner in OCR Mode -->
                            <Border x:Name="OcrBanner"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Background="#EE141824"
                                    BorderBrush="{DynamicResource Brush.BorderStrong}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="10,4"
                                    Margin="0,8,0,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.55" Color="Black"/>
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE8C1;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                               Foreground="{DynamicResource Brush.Accent}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Drag to select text · Click Copy · Esc to exit" FontSize="11"
                                               Foreground="{DynamicResource Brush.TextHeading}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Border CornerRadius="4" Background="{DynamicResource Brush.Subtle}" Padding="6,2" Cursor="Hand"
                                            MouseLeftButtonDown="ExitOcrMode_Click" ToolTip="Exit OCR selection mode">
                                        <TextBlock Text="Done" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Accent}"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Floating Action Popup (Appears right next to cursor after selecting text) -->
                            <Border x:Name="OcrFloatingCopyPopup"
                                    Visibility="Collapsed"
                                    Background="#F2161A26"
                                    BorderBrush="{DynamicResource Brush.Accent}"
                                    BorderThickness="1.5"
                                    CornerRadius="6"
                                    Padding="4,3">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.65" Color="Black"/>
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Open Link Button (Visible when selection contains/is a URL) -->
                                    <Border x:Name="OcrFloatingOpenLinkBtn"
                                            CornerRadius="4"
                                            Background="{DynamicResource Brush.Subtle}"
                                            Padding="6,3"
                                            Margin="0,0,4,0"
                                            Cursor="Hand"
                                            Visibility="Collapsed"
                                            ToolTip="Open recognized link in default browser"
                                            MouseLeftButtonDown="OcrFloatingOpenLink_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                       Foreground="#FF00D2FF" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Open Link" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.TextHeading}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Copy Button -->
                                    <Border x:Name="OcrFloatingCopyBtn"
                                            CornerRadius="4"
                                            Background="{DynamicResource Brush.Subtle}"
                                            Padding="6,3"
                                            Cursor="Hand"
                                            ToolTip="Click to copy selected text (Ctrl+C)"
                                            MouseLeftButtonDown="OcrFloatingCopy_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                       Foreground="{DynamicResource Brush.Accent}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="OcrFloatingCopyLabel" Text="Copy" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.TextHeading}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Canvas>

                        <!-- Interactive Annotation Drawing & Overlay Layer (Active during Annotate Mode) -->
                        <Canvas x:Name="AnnotationInteractionLayer"
                                Background="Transparent"
                                Visibility="Collapsed"
                                Cursor="Cross"
                                ClipToBounds="True"
                                MouseLeftButtonDown="AnnotationLayer_MouseDown"
                                MouseMove="AnnotationLayer_MouseMove"
                                MouseLeftButtonUp="AnnotationLayer_MouseUp">

                            <!-- In-place text box for text annotations -->
                            <Border x:Name="AnnotationTextHost"
                                    Visibility="Collapsed"
                                    Background="#EE141824"
                                    BorderBrush="{DynamicResource Brush.Accent}"
                                    BorderThickness="1.5"
                                    CornerRadius="5"
                                    Padding="4,2">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.6" Color="Black"/>
                                </Border.Effect>
                                <TextBox x:Name="AnnotationInputBox"
                                         MinWidth="120"
                                         Background="Transparent"
                                         Foreground="{DynamicResource Brush.TextHeading}"
                                         BorderThickness="0"
                                         FontSize="13"
                                         FontWeight="SemiBold"
                                         CaretBrush="{DynamicResource Brush.Accent}"
                                         KeyDown="AnnotationInputBox_KeyDown"
                                         LostFocus="AnnotationInputBox_LostFocus"/>
                            </Border>

                            <!-- Live preview shape path (arrows) -->
                            <Path x:Name="DrawPreviewPath"
                                  Visibility="Collapsed"
                                  Stroke="#FFFF4D4F"
                                  Fill="#FFFF4D4F"
                                  StrokeThickness="3"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>

                            <!-- Live preview ellipse (circles) -->
                            <Ellipse x:Name="DrawPreviewEllipse"
                                     Visibility="Collapsed"
                                     Stroke="#FFFF4D4F"
                                     Fill="Transparent"
                                     StrokeThickness="3"/>
                        </Canvas>

                        <!-- Floating Annotation Toolbar (Top-Center of Viewport) -->
                        <Border x:Name="AnnotateToolbar"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Margin="0,10,0,0"
                                Background="#F2141826"
                                BorderBrush="{DynamicResource Brush.BorderStrong}"
                                BorderThickness="1.2"
                                CornerRadius="18"
                                Padding="6,3"
                                Visibility="Collapsed">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.65" Color="Black"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Tool selection -->
                                <RadioButton x:Name="ToolArrowRadio"
                                             Style="{StaticResource ToolRadioStyle}"
                                             GroupName="AnnotateTools"
                                             IsChecked="True"
                                             Click="ToolRadio_Click"
                                             Tag="Arrow"
                                             ToolTip="Arrow (A) · Drag to draw directed arrow">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xEDBE;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Arrow" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="ToolCircleRadio"
                                             Style="{StaticResource ToolRadioStyle}"
                                             GroupName="AnnotateTools"
                                             Click="ToolRadio_Click"
                                             Tag="Circle"
                                             ToolTip="Circle (C) · Drag to draw circle/ellipse">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xEA3B;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Circle" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="ToolTextRadio"
                                             Style="{StaticResource ToolRadioStyle}"
                                             GroupName="AnnotateTools"
                                             Click="ToolRadio_Click"
                                             Tag="Text"
                                             ToolTip="Text (T) · Click image to type label">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE8D2;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Text" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="ToolLinkRadio"
                                             Style="{StaticResource ToolRadioStyle}"
                                             GroupName="AnnotateTools"
                                             Click="ToolRadio_Click"
                                             Tag="Hyperlink"
                                             ToolTip="Add Hyperlink Button (L) · Click image to place clickable website link">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#FF00D2FF" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Link" FontSize="11" FontWeight="SemiBold" Foreground="#FF00D2FF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <Border Width="1" Height="16" Background="{DynamicResource Brush.Border}" Margin="5,0"/>

                                <!-- Color swatches -->
                                <Border x:Name="ColorSwatchRed" Width="18" Height="18" CornerRadius="9" Background="#FFFF4D4F"
                                        BorderBrush="#FFFFFFFF" BorderThickness="2" Margin="2,0" Cursor="Hand"
                                        ToolTip="Red" MouseLeftButtonDown="ColorSwatch_Click" Tag="#FFFF4D4F"/>
                                <Border x:Name="ColorSwatchBlue" Width="18" Height="18" CornerRadius="9" Background="#FF3B82F6"
                                        BorderBrush="Transparent" BorderThickness="2" Margin="2,0" Cursor="Hand"
                                        ToolTip="Blue" MouseLeftButtonDown="ColorSwatch_Click" Tag="#FF3B82F6"/>
                                <Border x:Name="ColorSwatchGreen" Width="18" Height="18" CornerRadius="9" Background="#FF10B981"
                                        BorderBrush="Transparent" BorderThickness="2" Margin="2,0" Cursor="Hand"
                                        ToolTip="Green" MouseLeftButtonDown="ColorSwatch_Click" Tag="#FF10B981"/>
                                <Border x:Name="ColorSwatchAmber" Width="18" Height="18" CornerRadius="9" Background="#FFF59E0B"
                                        BorderBrush="Transparent" BorderThickness="2" Margin="2,0" Cursor="Hand"
                                        ToolTip="Amber" MouseLeftButtonDown="ColorSwatch_Click" Tag="#FFF59E0B"/>
                                <Border x:Name="ColorSwatchWhite" Width="18" Height="18" CornerRadius="9" Background="#FFFFFFFF"
                                        BorderBrush="Transparent" BorderThickness="2" Margin="2,0" Cursor="Hand"
                                        ToolTip="White" MouseLeftButtonDown="ColorSwatch_Click" Tag="#FFFFFFFF"/>

                                <Border Width="1" Height="16" Background="{DynamicResource Brush.Border}" Margin="5,0"/>

                                <!-- Undo & Clear -->
                                <Button Style="{StaticResource MiniToolbarBtnStyle}" Click="AnnotateUndo_Click" ToolTip="Undo last annotation (Ctrl+Z)">
                                    <TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource Brush.TextHeading}"/>
                                </Button>
                                <Button Style="{StaticResource MiniToolbarBtnStyle}" Click="AnnotateClear_Click" ToolTip="Clear all annotations">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource Brush.Danger}"/>
                                </Button>

                                <Border Width="1" Height="16" Background="{DynamicResource Brush.Border}" Margin="4,0"/>

                                <!-- Done button -->
                                <Button Style="{StaticResource MiniToolbarBtnStyle}" Click="AnnotateDone_Click" ToolTip="Done / Close toolbar (Esc)">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,4,0"/>
                                        <TextBlock Text="Done" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
            </Border>
        </Grid>

        <!-- Small transparent overlay on top right corner (Active in Minimal / Title-bar-less mode) -->
        <Border x:Name="FramelessOverlay"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,6,6,0"
                        CornerRadius="6"
                        Background="#D0121722"
                        BorderBrush="{DynamicResource Brush.BorderStrong}"
                        BorderThickness="1"
                        Padding="3,2"
                        Opacity="0.45"
                        Visibility="Collapsed"
                        MouseEnter="FramelessOverlay_MouseEnter"
                        MouseLeave="FramelessOverlay_MouseLeave">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.55" Color="Black"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 1. Restore Title Bar Button -->
                        <Button Style="{StaticResource OverlayMiniButtonStyle}"
                                Click="ExitFrameless_Click"
                                ToolTip="Show Title Bar / Full Controls">
                            <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{DynamicResource Brush.Accent}"/>
                        </Button>

                        <!-- 2. Topmost toggle -->
                        <Button x:Name="OverlayTopmostBtn"
                                Style="{StaticResource OverlayMiniButtonStyle}"
                                Click="TopmostToggle_Click"
                                ToolTip="Always on Top (Click to toggle)">
                            <TextBlock x:Name="OverlayTopmostIcon" Text="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{DynamicResource Brush.Accent}"/>
                        </Button>

                        <!-- 3. Copy button -->
                        <Button Style="{StaticResource OverlayMiniButtonStyle}"
                                Click="Copy_Click"
                                ToolTip="Copy image (Ctrl+C)">
                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{DynamicResource Brush.TextHeading}"/>
                        </Button>

                        <!-- 4. Three dots menu button (placed to the right of Copy icon and before Unpin button) -->
                        <Button x:Name="OverlayMenuBtn"
                                Style="{StaticResource OverlayMiniButtonStyle}"
                                Click="OverlayMenu_Click"
                                ToolTip="All Options · Desktop Pin, Zoom, Copy, OCR, Settings">
                            <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{DynamicResource Brush.TextHeading}"/>
                        </Button>

                        <!-- 5. Unpin button -->
                        <Button Style="{StaticResource OverlayMiniButtonStyle}"
                                Click="Unpin_Click"
                                ToolTip="Unpin (Esc)">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10.5"
                                       Foreground="{DynamicResource Brush.Danger}"/>
                        </Button>
                    </StackPanel>
        </Border>
    </Grid>
</Window>
