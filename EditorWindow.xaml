<Window x:Class="AdvancedSnip.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit capture"
        Icon="ASico.ico"
        Width="1040" Height="740"
        MinWidth="720" MinHeight="520"
        FontFamily="Segoe UI"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        WindowStartupLocation="Manual"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>

        <!-- An action in the toolbar. -->
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource Brush.TextBody}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="10,7"/>
            <Setter Property="Margin"          Value="1,0"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource Brush.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A tool selection in the toolbar; exactly one is active at a time.
             RadioButton rather than ToggleButton: GroupName is what gives mutual
             exclusion for free, and it only exists on RadioButton. RadioButton derives
             from ToggleButton, so IsChecked and the Checked event work unchanged. -->
        <Style x:Key="ToolToggle" TargetType="RadioButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource Brush.TextBody}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="10,7"/>
            <Setter Property="Margin"          Value="1,0"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="GroupName"       Value="Tool"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource Brush.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource Brush.AccentSoft}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource Brush.Accent}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Background"  Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Foreground"  Value="{DynamicResource Brush.OnAccent}"/>
            <Setter Property="Padding"     Value="18,8"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource Brush.AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Padding" Value="16,8"/>
        </Style>

        <!-- The small uppercase word that names a group of buttons. Sits beside the
             group rather than above it, so naming the categories costs no extra height. -->
        <Style x:Key="GroupLabel" TargetType="TextBlock">
            <Setter Property="FontSize"            Value="9.5"/>
            <Setter Property="FontWeight"          Value="SemiBold"/>
            <Setter Property="Foreground"          Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="Margin"              Value="4,0,7,0"/>
        </Style>

        <Style x:Key="Sep" TargetType="Rectangle">
            <Setter Property="Width"  Value="1"/>
            <Setter Property="Margin" Value="7,8"/>
            <Setter Property="Fill"   Value="{DynamicResource Brush.Border}"/>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- ── Toolbar ─────────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource Brush.Card}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,0,1">
            <!-- Grouped by what each control acts on, and captioned so the grouping is
                 stated rather than implied by a thin line. Three groups:

                   TOOLS   — change what a drag on the picture does
                   ADJUST  — act on the whole image, geometrically
                   EXTRACT — pull something out of the picture

                 Undo and Redo are docked right, away from the groups: they undo any of
                 them, so sitting inside one would claim they belong to it. A fixed
                 position also matters for a control reached this often — the toolbar
                 wraps on a narrow window, and a floating Undo is one that has to be
                 hunted for.

                 Colour and size moved out entirely, into the row below. They only apply
                 to the six drawing tools, so on a bar that also has Crop, Select text and
                 no-tool-at-all they were permanent furniture serving a sometimes-case. -->
            <DockPanel Margin="8,6">

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Rectangle Style="{StaticResource Sep}"/>
                    <Button x:Name="UndoBtn" Style="{StaticResource ToolBtn}"
                            Content="&#x21B6; Undo" ToolTip="Ctrl+Z" Click="Undo_Click"/>
                    <Button x:Name="RedoBtn" Style="{StaticResource ToolBtn}"
                            Content="&#x21B7; Redo" ToolTip="Ctrl+Y" Click="Redo_Click"/>
                </StackPanel>

                <WrapPanel Orientation="Horizontal">

                    <TextBlock Text="TOOLS" Style="{StaticResource GroupLabel}"/>
                    <RadioButton x:Name="ToolCrop"  Style="{StaticResource ToolToggle}"
                                 Content="&#x26F6;  Crop" ToolTip="Drag a box, then press Enter (C)"
                                 Checked="Tool_Checked"/>
                    <RadioButton x:Name="ToolPen"   Style="{StaticResource ToolToggle}"
                                 Content="&#x270E;  Pen" ToolTip="Freehand draw (P)"
                                 Checked="Tool_Checked"/>
                    <RadioButton x:Name="ToolMark"  Style="{StaticResource ToolToggle}"
                                 Content="&#x25AC;  Marker" ToolTip="Translucent highlighter (H)"
                                 Checked="Tool_Checked"/>
                    <RadioButton x:Name="ToolRect"  Style="{StaticResource ToolToggle}"
                                 Content="&#x25AD;  Box" ToolTip="Rectangle outline (R)"
                                 Checked="Tool_Checked"/>
                    <RadioButton x:Name="ToolEllipse" Style="{StaticResource ToolToggle}"
                                 Content="&#x25EF;  Ellipse" ToolTip="Ellipse outline (E)"
                                 Checked="Tool_Checked"/>
                    <RadioButton x:Name="ToolArrow" Style="{StaticResource ToolToggle}"
                                 Content="&#x2197;  Arrow" ToolTip="Arrow (A)"
                                 Checked="Tool_Checked"/>
                    <RadioButton x:Name="ToolRedact" Style="{StaticResource ToolToggle}"
                                 Content="&#x2588;  Redact"
                                 ToolTip="Solid block over sensitive content (B)"
                                 Checked="Tool_Checked"/>
                    <RadioButton x:Name="ToolText"   Style="{StaticResource ToolToggle}"
                                 Content="I  Select text"
                                 ToolTip="Drag across words in the picture to select and copy them (T)"
                                 Checked="Tool_Checked"/>

                    <Rectangle Style="{StaticResource Sep}"/>

                    <TextBlock Text="ADJUST" Style="{StaticResource GroupLabel}"/>
                    <Button x:Name="RotateLeftBtn"  Style="{StaticResource ToolBtn}"
                            Content="&#x21BA;" ToolTip="Rotate left"  Click="RotateLeft_Click"/>
                    <Button x:Name="RotateRightBtn" Style="{StaticResource ToolBtn}"
                            Content="&#x21BB;" ToolTip="Rotate right" Click="RotateRight_Click"/>
                    <Button x:Name="FlipHBtn"       Style="{StaticResource ToolBtn}"
                            Content="&#x21CB;" ToolTip="Flip horizontally" Click="FlipH_Click"/>
                    <Button x:Name="FlipVBtn"       Style="{StaticResource ToolBtn}"
                            Content="&#x21C5;" ToolTip="Flip vertically"   Click="FlipV_Click"/>

                    <Rectangle Style="{StaticResource Sep}"/>

                    <TextBlock Text="EXTRACT" Style="{StaticResource GroupLabel}"/>
                    <Button x:Name="RemoveBgBtn" Style="{StaticResource ToolBtn}"
                            Content="&#x2B1A; Remove background"
                            ToolTip="Make a flat background transparent"
                            Click="RemoveBg_Click"/>
                    <Button x:Name="CopyTextBtn" Style="{StaticResource ToolBtn}"
                            Content="&#x1F5D0; Copy text"
                            ToolTip="Read the text in this image (Ctrl+Shift+C)"
                            Click="CopyText_Click"/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- ── Drawing options ─────────────────────────────────────────────────
             Colour and stroke width, shown only while a tool that uses them is selected.
             They used to sit permanently on the main bar, where they were the widest
             thing on it and meaningless for Crop, Select text, or no tool at all.

             A row that appears and disappears does move the canvas, which is why it is
             worth the trade only for controls this conditional: six of the eight tools
             want them and the other two cannot use them at all. -->
        <Border x:Name="DrawOptions" DockPanel.Dock="Top" Visibility="Collapsed"
                Background="{DynamicResource Brush.Subtle}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                Padding="12,7">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="COLOUR" Style="{StaticResource GroupLabel}"/>

                <!-- Colour swatches. Tag carries the hex the code-behind parses. -->
                <ItemsControl x:Name="SwatchList" VerticalAlignment="Center" Margin="0,0,4,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <Rectangle Style="{StaticResource Sep}"/>

                <TextBlock Text="SIZE" Style="{StaticResource GroupLabel}"/>
                <Slider x:Name="ThicknessSlider" Width="110" Minimum="1" Maximum="24" Value="4"
                        VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1"
                        ValueChanged="Thickness_Changed"/>
                <TextBlock x:Name="ThicknessLabel" Text="4 px" VerticalAlignment="Center"
                           Margin="8,0,0,0" MinWidth="34"
                           Foreground="{DynamicResource Brush.TextBody}" FontSize="12"/>
            </StackPanel>
        </Border>

        <!-- ── Background removal controls ─────────────────────────────────── -->
        <Border x:Name="BgPanel" DockPanel.Dock="Top" Visibility="Collapsed"
                Background="{DynamicResource Brush.Subtle}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                Padding="14,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BgCancelBtn" Style="{StaticResource Ghost}"
                            Content="Cancel" Click="BgCancel_Click"/>
                    <Button x:Name="BgApplyBtn" Style="{StaticResource Primary}"
                            Content="Apply" Margin="8,0,0,0" Click="BgApply_Click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Tolerance" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource Brush.TextMuted}"/>
                    <Slider x:Name="BgTolerance" Width="130" Minimum="2" Maximum="60" Value="14"
                            Margin="8,0" VerticalAlignment="Center"
                            IsSnapToTickEnabled="True" TickFrequency="1"
                            ValueChanged="BgSetting_Changed"/>

                    <TextBlock Text="Edge softness" VerticalAlignment="Center" FontSize="12"
                               Margin="12,0,0,0"
                               Foreground="{DynamicResource Brush.TextMuted}"/>
                    <Slider x:Name="BgFeather" Width="90" Minimum="0" Maximum="6" Value="2"
                            Margin="8,0" VerticalAlignment="Center"
                            IsSnapToTickEnabled="True" TickFrequency="1"
                            ValueChanged="BgSetting_Changed"/>

                    <TextBlock x:Name="BgStatus" VerticalAlignment="Center" FontSize="12"
                               Margin="12,0,0,0" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Brush.TextBody}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Recognised text ─────────────────────────────────────────────── -->
        <Border x:Name="TextPanel" DockPanel.Dock="Bottom" Visibility="Collapsed"
                Background="{DynamicResource Brush.Subtle}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
                Padding="14,10" MaxHeight="220">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock x:Name="TextPanelTitle" Text="Text found in this image"
                               FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.TextHeading}"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <!-- Starts disabled: recognition runs after the panel opens, so
                             for the first moment there is genuinely nothing to copy. -->
                        <Button x:Name="TextCopyBtn" Style="{StaticResource Ghost}"
                                Content="Copy all text" Padding="10,3" IsEnabled="False"
                                ToolTip="Put every word found in this picture on the clipboard"
                                Click="TextCopyAll_Click"/>
                        <Button x:Name="TextCloseBtn" Style="{StaticResource Ghost}"
                                Content="✕" Padding="8,3" Margin="6,0,0,0"
                                Click="TextClose_Click"/>
                    </StackPanel>
                </DockPanel>

                <TextBox x:Name="OcrTextBox" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="Wrap" FontSize="12" MinHeight="60"
                         VerticalScrollBarVisibility="Auto"/>
            </DockPanel>
        </Border>

        <!-- ── Status / actions ────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource Brush.Card}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,1,0,0">
            <DockPanel Margin="14,10">

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <!-- Open moved down here from the tool bar. It is a file operation, and
                         it was sitting among drawing tools while its whole family — Copy,
                         PDF, Export, Save — lived on this row. -->
                    <Button x:Name="OpenBtn"   Style="{StaticResource Ghost}"
                            Content="Open…"
                            ToolTip="Open another image, or just drag one onto this window (Ctrl+O)"
                            Click="Open_Click" Margin="0,0,14,0"/>
                    <Button x:Name="CopyBtn"   Style="{StaticResource Ghost}"
                            Content="Copy"    ToolTip="Ctrl+C" Click="Copy_Click"/>
                    <Button x:Name="PdfBtn"    Style="{StaticResource Ghost}"
                            Content="PDF…"    ToolTip="Ctrl+P — turn this into a PDF, splitting a tall image across pages"
                            Click="Pdf_Click"/>
                    <Button x:Name="SaveAsBtn" Style="{StaticResource Ghost}"
                            Content="Export…" ToolTip="PNG, JPEG, BMP, TIFF or ICO"
                            Click="SaveAs_Click"/>
                    <Button x:Name="SaveBtn"   Style="{StaticResource Primary}"
                            Content="Save"    ToolTip="Ctrl+S" Margin="8,0,0,0"
                            Click="Save_Click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="SizeText" FontSize="12"
                               Foreground="{DynamicResource Brush.TextFaint}"/>
                    <TextBlock Text="  ·  " FontSize="12"
                               Foreground="{DynamicResource Brush.TextMuted}"/>
                    <TextBlock x:Name="ZoomText" FontSize="12"
                               Foreground="{DynamicResource Brush.TextFaint}"/>
                    <TextBlock Text="  ·  " FontSize="12"
                               Foreground="{DynamicResource Brush.TextMuted}"/>
                    <TextBlock x:Name="HintText" FontSize="12"
                               Foreground="{DynamicResource Brush.TextMuted}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Canvas ──────────────────────────────────────────────────────── -->
        <ScrollViewer x:Name="Scroller"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="{DynamicResource Brush.CanvasBack}"
                      PreviewMouseWheel="Scroller_PreviewMouseWheel"
                      ScrollChanged="Scroller_ScrollChanged">
            <!-- The stage is sized in code to exactly pixelWidth × zoom, so a point on
                 the overlay divides cleanly back to an image pixel with no guesswork. -->
            <Grid x:Name="Stage" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Margin="24" Background="Transparent">
                <Image x:Name="Canvas1" Stretch="Fill"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <Canvas x:Name="TextLayer" Background="Transparent"
                        IsHitTestVisible="False"/>
                <Canvas x:Name="Overlay" Background="Transparent"
                        MouseLeftButtonDown="Overlay_MouseDown"
                        MouseMove="Overlay_MouseMove"
                        MouseLeftButtonUp="Overlay_MouseUp"
                        MouseLeave="Overlay_MouseLeave"/>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
