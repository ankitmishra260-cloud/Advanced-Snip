<Window x:Class="AdvancedSnip.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit capture"
        Width="1040" Height="740"
        MinWidth="720" MinHeight="520"
        FontFamily="Segoe UI"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        WindowStartupLocation="Manual"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>

        <!-- An action in the toolbar. -->
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource Brush.TextBody}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="10,7"/>
            <Setter Property="Margin"          Value="1,0"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource Brush.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A tool selection in the toolbar; exactly one is active at a time.
             RadioButton rather than ToggleButton: GroupName is what gives mutual
             exclusion for free, and it only exists on RadioButton. RadioButton derives
             from ToggleButton, so IsChecked and the Checked event work unchanged. -->
        <Style x:Key="ToolToggle" TargetType="RadioButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource Brush.TextBody}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="10,7"/>
            <Setter Property="Margin"          Value="1,0"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="GroupName"       Value="Tool"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource Brush.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource Brush.AccentSoft}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource Brush.Accent}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Background"  Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Foreground"  Value="{DynamicResource Brush.OnAccent}"/>
            <Setter Property="Padding"     Value="18,8"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource Brush.AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Padding" Value="16,8"/>
        </Style>

        <Style x:Key="Sep" TargetType="Rectangle">
            <Setter Property="Width"  Value="1"/>
            <Setter Property="Margin" Value="7,8"/>
            <Setter Property="Fill"   Value="{DynamicResource Brush.Border}"/>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- ── Toolbar ─────────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource Brush.Card}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,0,1">
            <WrapPanel Orientation="Horizontal" Margin="8,6" >

                <RadioButton x:Name="ToolCrop"  Style="{StaticResource ToolToggle}"
                              Content="⛶  Crop" ToolTip="Drag a box, then press Enter (C)"
                              Checked="Tool_Checked"/>
                <RadioButton x:Name="ToolPen"   Style="{StaticResource ToolToggle}"
                              Content="✎  Pen" ToolTip="Freehand draw (P)"
                              Checked="Tool_Checked"/>
                <RadioButton x:Name="ToolMark"  Style="{StaticResource ToolToggle}"
                              Content="▬  Highlight" ToolTip="Translucent marker (H)"
                              Checked="Tool_Checked"/>
                <RadioButton x:Name="ToolRect"  Style="{StaticResource ToolToggle}"
                              Content="▭  Box" ToolTip="Rectangle outline (R)"
                              Checked="Tool_Checked"/>
                <RadioButton x:Name="ToolEllipse" Style="{StaticResource ToolToggle}"
                              Content="◯  Ellipse" ToolTip="Ellipse outline (E)"
                              Checked="Tool_Checked"/>
                <RadioButton x:Name="ToolArrow" Style="{StaticResource ToolToggle}"
                              Content="↗  Arrow" ToolTip="Arrow (A)"
                              Checked="Tool_Checked"/>
                <RadioButton x:Name="ToolRedact" Style="{StaticResource ToolToggle}"
                              Content="█  Redact" ToolTip="Solid block over sensitive content (B)"
                              Checked="Tool_Checked"/>
                <RadioButton x:Name="ToolText"   Style="{StaticResource ToolToggle}"
                              Content="I  Select text"
                              ToolTip="Drag across words in the picture to select and copy them (T)"
                              Checked="Tool_Checked"/>

                <Rectangle Style="{StaticResource Sep}"/>

                <Button x:Name="RotateLeftBtn"  Style="{StaticResource ToolBtn}"
                        Content="↺" ToolTip="Rotate left"  Click="RotateLeft_Click"/>
                <Button x:Name="RotateRightBtn" Style="{StaticResource ToolBtn}"
                        Content="↻" ToolTip="Rotate right" Click="RotateRight_Click"/>
                <Button x:Name="FlipHBtn"       Style="{StaticResource ToolBtn}"
                        Content="⇋" ToolTip="Flip horizontally" Click="FlipH_Click"/>
                <Button x:Name="FlipVBtn"       Style="{StaticResource ToolBtn}"
                        Content="⇅" ToolTip="Flip vertically"   Click="FlipV_Click"/>

                <Rectangle Style="{StaticResource Sep}"/>

                <Button x:Name="OpenBtn" Style="{StaticResource ToolBtn}"
                        Content="📂 Open"
                        ToolTip="Open another image, or just drag one onto this window (Ctrl+O)"
                        Click="Open_Click"/>
                <Button x:Name="RemoveBgBtn" Style="{StaticResource ToolBtn}"
                        Content="⬚ Remove BG"
                        ToolTip="Make a flat background transparent"
                        Click="RemoveBg_Click"/>
                <Button x:Name="CopyTextBtn" Style="{StaticResource ToolBtn}"
                        Content="🗐 Copy text"
                        ToolTip="Read the text in this image (Ctrl+Shift+C)"
                        Click="CopyText_Click"/>

                <Rectangle Style="{StaticResource Sep}"/>

                <Button x:Name="UndoBtn" Style="{StaticResource ToolBtn}"
                        Content="↶ Undo" ToolTip="Ctrl+Z" Click="Undo_Click"/>
                <Button x:Name="RedoBtn" Style="{StaticResource ToolBtn}"
                        Content="↷ Redo" ToolTip="Ctrl+Y" Click="Redo_Click"/>

                <Rectangle Style="{StaticResource Sep}"/>

                <!-- Colour swatches. Tag carries the hex the code-behind parses. -->
                <ItemsControl x:Name="SwatchList" VerticalAlignment="Center" Margin="4,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <TextBlock Text="Size" VerticalAlignment="Center" Margin="12,0,6,0"
                           Foreground="{DynamicResource Brush.TextMuted}" FontSize="12"/>
                <Slider x:Name="ThicknessSlider" Width="90" Minimum="1" Maximum="24" Value="4"
                        VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1"
                        ValueChanged="Thickness_Changed"/>
                <TextBlock x:Name="ThicknessLabel" Text="4 px" VerticalAlignment="Center"
                           Margin="6,0,0,0" MinWidth="34"
                           Foreground="{DynamicResource Brush.TextMuted}" FontSize="12"/>
            </WrapPanel>
        </Border>

        <!-- ── Background removal controls ─────────────────────────────────── -->
        <Border x:Name="BgPanel" DockPanel.Dock="Top" Visibility="Collapsed"
                Background="{DynamicResource Brush.Subtle}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                Padding="14,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BgCancelBtn" Style="{StaticResource Ghost}"
                            Content="Cancel" Click="BgCancel_Click"/>
                    <Button x:Name="BgApplyBtn" Style="{StaticResource Primary}"
                            Content="Apply" Margin="8,0,0,0" Click="BgApply_Click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Tolerance" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource Brush.TextMuted}"/>
                    <Slider x:Name="BgTolerance" Width="130" Minimum="2" Maximum="60" Value="14"
                            Margin="8,0" VerticalAlignment="Center"
                            IsSnapToTickEnabled="True" TickFrequency="1"
                            ValueChanged="BgSetting_Changed"/>

                    <TextBlock Text="Edge softness" VerticalAlignment="Center" FontSize="12"
                               Margin="12,0,0,0"
                               Foreground="{DynamicResource Brush.TextMuted}"/>
                    <Slider x:Name="BgFeather" Width="90" Minimum="0" Maximum="6" Value="2"
                            Margin="8,0" VerticalAlignment="Center"
                            IsSnapToTickEnabled="True" TickFrequency="1"
                            ValueChanged="BgSetting_Changed"/>

                    <TextBlock x:Name="BgStatus" VerticalAlignment="Center" FontSize="12"
                               Margin="12,0,0,0" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Brush.TextBody}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Recognised text ─────────────────────────────────────────────── -->
        <Border x:Name="TextPanel" DockPanel.Dock="Bottom" Visibility="Collapsed"
                Background="{DynamicResource Brush.Subtle}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
                Padding="14,10" MaxHeight="220">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock x:Name="TextPanelTitle" Text="Text found in this image"
                               FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.TextHeading}"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="TextCopyBtn" Style="{StaticResource Ghost}"
                                Content="Copy all" Padding="10,3" Click="TextCopyAll_Click"/>
                        <Button x:Name="TextCloseBtn" Style="{StaticResource Ghost}"
                                Content="✕" Padding="8,3" Margin="6,0,0,0"
                                Click="TextClose_Click"/>
                    </StackPanel>
                </DockPanel>

                <TextBox x:Name="OcrTextBox" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="Wrap" FontSize="12" MinHeight="60"
                         VerticalScrollBarVisibility="Auto"/>
            </DockPanel>
        </Border>

        <!-- ── Status / actions ────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource Brush.Card}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,1,0,0">
            <DockPanel Margin="14,10">

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="CopyBtn"   Style="{StaticResource Ghost}"
                            Content="Copy"    ToolTip="Ctrl+C" Click="Copy_Click"/>
                    <Button x:Name="SaveAsBtn" Style="{StaticResource Ghost}"
                            Content="Export…" ToolTip="PNG, JPEG, BMP, TIFF or ICO"
                            Click="SaveAs_Click"/>
                    <Button x:Name="SaveBtn"   Style="{StaticResource Primary}"
                            Content="Save"    ToolTip="Ctrl+S" Margin="8,0,0,0"
                            Click="Save_Click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="SizeText" FontSize="12"
                               Foreground="{DynamicResource Brush.TextFaint}"/>
                    <TextBlock Text="  ·  " FontSize="12"
                               Foreground="{DynamicResource Brush.TextMuted}"/>
                    <TextBlock x:Name="ZoomText" FontSize="12"
                               Foreground="{DynamicResource Brush.TextFaint}"/>
                    <TextBlock Text="  ·  " FontSize="12"
                               Foreground="{DynamicResource Brush.TextMuted}"/>
                    <TextBlock x:Name="HintText" FontSize="12"
                               Foreground="{DynamicResource Brush.TextMuted}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Canvas ──────────────────────────────────────────────────────── -->
        <ScrollViewer x:Name="Scroller"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="{DynamicResource Brush.CanvasBack}"
                      PreviewMouseWheel="Scroller_PreviewMouseWheel">
            <!-- The stage is sized in code to exactly pixelWidth × zoom, so a point on
                 the overlay divides cleanly back to an image pixel with no guesswork. -->
            <Grid x:Name="Stage" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Margin="24" Background="Transparent">
                <Image x:Name="Canvas1" Stretch="Fill"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <Canvas x:Name="TextLayer" Background="Transparent"
                        IsHitTestVisible="False"/>
                <Canvas x:Name="Overlay" Background="Transparent"
                        MouseLeftButtonDown="Overlay_MouseDown"
                        MouseMove="Overlay_MouseMove"
                        MouseLeftButtonUp="Overlay_MouseUp"
                        MouseLeave="Overlay_MouseLeave"/>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
